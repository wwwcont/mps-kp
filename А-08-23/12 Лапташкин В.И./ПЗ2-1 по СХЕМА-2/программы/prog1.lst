                     1  ; Лапташкин В.И., А-08-23, 12, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=12 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 12            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 65F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1528
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Ch          ; флаг пустоты буфера (21h.4)
              =1    26  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2068 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0ECh
              =1    36  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 30h
              =1    38  Y1_TICKS     EQU 149           ; T1 = 298 мс
              =1    39  T3_TICKS     EQU 1410          ; T3 = 2820 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; переменные в ОЗУ не нужны: всё держим в регистрах R2-R6 и сохраняем в стеке
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек сразу за банком 0
002E D2B4           26          setb PIN_CSEN           ; разрешить дешифратор CS (без него movx никуда не попадёт)
0030 90C000         27          mov DPTR, #ADR_KB       ; регистр столбцов клавиатуры
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; опустить все столбцы: любое нажатие сразу даст спад на INT0
0035 D288           30          setb IT0                ; INT0 срабатывает по спаду
0037 C289           31          clr IE0                 ; забыть возможный ложный запрос от включения
0039 D2A8           32          setb EX0                ; разрешить прерывание от клавиатуры
003B D2AF           33          setb EA                 ; и прерывания вообще
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос матрицы 4x3 по столбцам, вызывается из обработчика INT0.
                    37  ; Каждый столбец опускается по очереди, при этом читаются три строки.
                    38  ; Считаем, сколько контактов замкнуто: ровно один — код по табл. 3 ТЗ, иначе 0FFh.
                    39  ; Вход: нет. Выход: A — код клавиши (0-9, Т = 10, С = 11) или 0FFh.
                    40  ; Портит: только A и флаги; R2-R6, B, DPTR сохраняются в стеке.
003F                41  KbScan:
003F C0D0           42          push PSW
0041 C082           43          push DPL
0043 C083           44          push DPH
0045 C002           45          push AR2
0047 C003           46          push AR3
0049 C004           47          push AR4
004B C005           48          push AR5
004D C006           49          push AR6
004F 90C000         50          mov DPTR, #ADR_KB       ; одна ячейка: запись — столбцы, чтение — строки
0052 7B00           51          mov R3, #0              ; номер клавиши (строка * 4 + столбец) последнего замыкания
0054 7C00           52          mov R4, #0              ; сколько замыканий нашли за весь опрос
0056 7DFE           53          mov R5, #0FEh           ; маска: ноль в бите опрашиваемого столбца
0058 7A00           54          mov R2, #0              ; номер текущего столбца, 0..3
005A                55  KbCol:
005A ED             56          mov A, R5
005B F0             57          movx @DPTR, A           ; опустить только этот столбец
005C E0             58          movx A, @DPTR           ; снять состояние строк
005D 5407           59          anl A, #(1 SHL KB_ROWS) - 1 ; старшие биты шины не подключены — отбросить
005F AE02           60          mov R6, AR2             ; номер клавиши в первой строке равен номеру столбца
0061 75F003         61          mov B, #KB_ROWS         ; сколько строк перебрать
0064                62  KbRow:
0064 13             63          rrc A                   ; бит очередной строки уходит в C
0065 4003           64          jc KbRowNext            ; единица — контакт разомкнут
0067 0C             65          inc R4                  ; нашли ещё одно замыкание
0068 AB06           66          mov R3, AR6             ; запомнить, какая это клавиша
006A                67  KbRowNext:
006A CE             68          xch A, R6               ; номер клавиши для строки ниже
006B 2404           69          add A, #KB_COLS         ; больше на число столбцов
006D CE             70          xch A, R6
006E D5F0F3         71          djnz B, KbRow
0071 ED             72          mov A, R5               ; ноль в маске переносим на следующий столбец
0072 23             73          rl A
0073 FD             74          mov R5, A
0074 0A             75          inc R2
0075 BA04E2         76          cjne R2, #KB_COLS, KbCol
0078 E4             77          clr A
0079 F0             78          movx @DPTR, A           ; опрос окончен — снова опустить все столбцы для INT0
007A BC0107         79          cjne R4, #1, KbNone     ; ни одной или две и больше — ошибка
007D EB             80          mov A, R3
007E 900099         81          mov DPTR, #KbCodes
0081 93             82          movc A, @A+DPTR         ; номер клавиши -> код по табл. 3 ТЗ
0082 8002           83          sjmp KbOut
0084                84  KbNone:
0084 74FF           85          mov A, #0FFh            ; помеха или несколько клавиш сразу
0086                86  KbOut:
0086 C289           87          clr IE0                 ; пока перебирали столбцы, INT0 дёргался — сбросить лишний запрос
0088 D006           88          pop AR6
008A D005           89          pop AR5
008C D004           90          pop AR4
008E D003           91          pop AR3
0090 D002           92          pop AR2
0092 D083           93          pop DPH
0094 D082           94          pop DPL
0096 D0D0           95          pop PSW
0098 22             96          ret
                    97  
                    98  ; Коды клавиш по рис. 4 ТЗ (4 столбца x 3 строки), строка за строкой
0099                99  KbCodes:
0099 0102030A      100          DB 1, 2, 3, 10          ; Row1: 1 2 3 Т
009D 0405060B      101          DB 4, 5, 6, 11          ; Row2: 4 5 6 С
00A1 07080900      102          DB 7, 8, 9, 0           ; Row3: 7 8 9 0
                   103  END
                   104  
