                     1  ; Лапташкин В.И., А-08-23, 12, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=12 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 12            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 65F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1528
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Ch          ; флаг пустоты буфера (21h.4)
              =1    26  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2068 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0ECh
              =1    36  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 30h
              =1    38  Y1_TICKS     EQU 149           ; T1 = 298 мс
              =1    39  T3_TICKS     EQU 1410          ; T3 = 2820 мс
              =1    40  
                     3  ; Timer0 в режиме 2 (8 бит с автоперезагрузкой): переполнение каждые 200 мкс без программной перезагрузки,
                     4  ; 10 переполнений = один тик 2 мс из vars.inc, T3 = T3_TICKS таких тиков
                     5  SUB_US  EQU 200                 ; период переполнения Timer0, мкс (1 машинный цикл = 1 мкс)
                     6  SUB_N   EQU 10                  ; переполнений в одном тике 2 мс
                     7  DSEG AT 30h
                     8  SubCnt: DS 1                    ; сколько переполнений по 200 мкс осталось до конца тика
                     9  TicksL: DS 1                    ; счётчик тиков T3 для djnz: младший байт
                    10  TicksH: DS 1                    ; старший байт (сколько раз пройти младший до нуля)
                    11  CSEG AT 0h
0000 8029           12          sjmp START
0003                13  org 03h ; "заглушка" для INT0
0003 00             14          nop
0004 32             15          reti
000B                16  org 0bh                         ; Timer0 — тик для отсчёта T3
000B 02007D         17          ljmp T0Isr
0013                18  org 13h ; "заглушка" для INT1
0013 00             19          nop
0014 32             20          reti
001B                21  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             22          nop
001C 32             23          reti
0023                24  org 23h ; "заглушка" для UART
0023 00             25          nop
0024 32             26          reti
002B                27  org 2bh
002B                28  START:
                    29  ; Инициализация МК **********************************************
002B 758107         30          mov SP, #07h            ; стек сразу за банком 0
002E D2B4           31          setb PIN_CSEN           ; разрешить дешифратор CS
0030 90A000         32          mov DPTR, #ADR_IND
0033 74FF           33          mov A, #IND_OFF
0035 F0             34          movx @DPTR, A           ; при включении индикатор тёмный
0036 758902         35          mov TMOD, #02h          ; Timer0 — режим 2, перезагрузка из TH0 аппаратно
0039 758C38         36          mov TH0, #256 - SUB_US  ; значение перезагрузки: 200 счётов до переполнения
003C C28C           37          clr TR0                 ; пока символа нет — таймер стоит
003E C28D           38          clr TF0
0040 D2A9           39          setb ET0                ; прерывание от Timer0
0042 D2AF           40          setb EA
0044 7405           41          mov A, #5               ; пример: показать «5»
0046 12004B         42          call Show ; %proc%
0049 80FE           43          jmp $ ; %stop%
                    44  
                    45  ; Show — показать символ на индикаторе и запустить отсчёт T3 до гашения.
                    46  ; Повторный вызов перезапускает T3 заново. Коды больше 10 гасят индикатор сразу.
                    47  ; Вход: A — код по табл. 2 ТЗ (0-9 — цифра, 10 — «E», больше — погасить).
                    48  ; Выход: нет (символ в регистре индикатора, Timer0 считает T3).
                    49  ; Портит: A и флаги; DPTR сохраняется в стеке.
004B                50  Show:
004B C082           51          push DPL
004D C083           52          push DPH
004F C28C           53          clr TR0                 ; прежний отсчёт T3 больше не нужен
0051 C28D           54          clr TF0                 ; и его недосчитанный запрос тоже
0053 B40B00         55          cjne A, #11, ShCmp      ; C = 1, если код меньше 11
0056                56  ShCmp:
0056 501A           57          jnc ShOff               ; кода такого нет — просто погасить
0058 90009E         58          mov DPTR, #SegTab
005B 93             59          movc A, @A+DPTR         ; сегменты для общего катода (1 — горит)
005C 64FF           60          xrl A, #IND_OFF         ; общий анод: сегмент зажигает 0, поэтому инвертируем
005E 90A000         61          mov DPTR, #ADR_IND
0061 F0             62          movx @DPTR, A           ; символ в регистр индикатора
0062 75300A         63          mov SubCnt, #SUB_N      ; новый тик начинается с нуля
0065 753182         64          mov TicksL, #LOW(T3_TICKS)        ; счёт под djnz: сначала младший байт до нуля,
0068 753206         65          mov TicksH, #HIGH(T3_TICKS - 1) + 1 ; потом по 256 на каждую единицу старшего
006B 758A38         66          mov TL0, #256 - SUB_US  ; первое переполнение через 200 мкс
006E D28C           67          setb TR0                ; пошёл отсчёт
0070 8006           68          sjmp ShRet
0072                69  ShOff:
0072 90A000         70          mov DPTR, #ADR_IND
0075 74FF           71          mov A, #IND_OFF
0077 F0             72          movx @DPTR, A           ; погасить все сегменты
0078                73  ShRet:
0078 D083           74          pop DPH
007A D082           75          pop DPL
007C 22             76          ret
                    77  
                    78  ; T0Isr — переполнение Timer0 раз в 200 мкс: каждые 10 раз — тик 2 мс, счёт тиков T3.
                    79  ; Когда тики кончились — индикатор гасится, таймер останавливается.
                    80  ; djnz флаги не меняет, поэтому PSW трогать не нужно; A сохраняется там, где используется.
                    81  ; Вход: SubCnt, TicksH:TicksL. Выход: нет. Портит: ничего.
007D                82  T0Isr:
007D D5301D         83          djnz SubCnt, T0Exit     ; тик 2 мс ещё не набрался
0080 75300A         84          mov SubCnt, #SUB_N      ; следующий тик
0083 D53117         85          djnz TicksL, T0Exit     ; минус один тик
0086 D53214         86          djnz TicksH, T0Exit     ; младший байт прошёл круг — минус 256 тиков
0089 C28C           87          clr TR0                 ; T3 истекло — больше не считать
008B C0E0           88          push ACC
008D C082           89          push DPL
008F C083           90          push DPH
0091 90A000         91          mov DPTR, #ADR_IND
0094 74FF           92          mov A, #IND_OFF
0096 F0             93          movx @DPTR, A           ; гасим индикатор
0097 D083           94          pop DPH
0099 D082           95          pop DPL
009B D0E0           96          pop ACC
009D                97  T0Exit:
009D 32             98          reti
                    99  
                   100  ; Сегменты цифр 0-9 и «E» для общего катода: D0..D7 = a, b, c, d, e, f, g, dp
009E               101  SegTab:
009E 3F065B4F66      102          DB 3Fh, 06h, 5Bh, 4Fh, 66h  ; 0 1 2 3 4
00A3 6D7D077F6F      103          DB 6Dh, 7Dh, 07h, 7Fh, 6Fh  ; 5 6 7 8 9
00A8 79            104          DB 79h                      ; E
                   105  END
                   106  
