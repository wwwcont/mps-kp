                     1  ; Лапташкин В.И., А-08-23, 12, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=12 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 12            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 65F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1528
              =1    14  BUF_X2IN     EQU 7FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 0Ch          ; флаг пустоты буфера (21h.4)
              =1    27  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2068 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0ECh
              =1    37  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 30h
              =1    39  Y1_TICKS     EQU 149           ; T1 = 298 мс
              =1    40  T3_TICKS     EQU 1410          ; T3 = 2820 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; своих переменных нет: указатели и флаги буфера заданы в vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек сразу за банком 0
002E D2B4           26          setb PIN_CSEN           ; разрешить дешифратор CS, иначе буфер не выбирается
0030 754000         27          mov HEAD_L, #LOW(BUF_START)  ; «голова» — на первую ячейку буфера
0033 754160         28          mov HEAD_H, #HIGH(BUF_START)
0036 754200         29          mov TAIL_L, #LOW(BUF_START)  ; «хвост» — туда же: буфер пуст
0039 754360         30          mov TAIL_H, #HIGH(BUF_START)
003C D20C           31          setb F_EMPTY            ; отсчётов нет
003E C214           32          clr F_OVF               ; переполнения не было
0040 120045         33          call BufRead ; %proc%
0043 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; BufRead — выдать самый старый отсчёт из кольцевого буфера в IDT7005.
                    37  ; Если буфер пуст, ничего не меняется и возвращается A = 0.
                    38  ; Иначе читается ячейка «хвоста», «хвост» сдвигается (за последней ячейкой —
                    39  ; снова первая), флаг переполнения снимается, а если «хвост» догнал «голову» —
                    40  ; ставится флаг пустоты.
                    41  ; Вход: нет. Выход: A — отсчёт (0 при пустом буфере); F_EMPTY, F_OVF.
                    42  ; Портит: A и флаги; DPTR и B сохраняются в стеке.
0045                43  BufRead:
0045 200C3A         44          jb F_EMPTY, BrEmpty     ; читать нечего
0048 C082           45          push DPL
004A C083           46          push DPH
004C C0F0           47          push B
004E 854282         48          mov DPL, TAIL_L         ; адрес самого старого отсчёта
0051 854383         49          mov DPH, TAIL_H
0054 E0             50          movx A, @DPTR           ; взять отсчёт из буфера
0055 F5F0           51          mov B, A                ; отложить, A нужен для сравнений
0057 A3             52          inc DPTR                ; следующая ячейка
0058 E582           53          mov A, DPL              ; вышли за конец буфера? сверяем оба байта
005A B4F808         54          cjne A, #LOW(BUF_END), BrSave
005D E583           55          mov A, DPH
005F B46503         56          cjne A, #HIGH(BUF_END), BrSave
0062 906000         57          mov DPTR, #BUF_START    ; заворот на начало кольца
0065                58  BrSave:
0065 858242         59          mov TAIL_L, DPL         ; запомнить новый «хвост»
0068 858343         60          mov TAIL_H, DPH
006B C214           61          clr F_OVF               ; одно место освободилось — буфер не полон
006D E542           62          mov A, TAIL_L           ; «хвост» догнал «голову» — всё прочитано
006F B54007         63          cjne A, HEAD_L, BrDone
0072 E543           64          mov A, TAIL_H
0074 B54102         65          cjne A, HEAD_H, BrDone
0077 D20C           66          setb F_EMPTY
0079                67  BrDone:
0079 E5F0           68          mov A, B                ; вернуть отсчёт
007B D0F0           69          pop B
007D D083           70          pop DPH
007F D082           71          pop DPL
0081 22             72          ret
0082                73  BrEmpty:
0082 E4             74          clr A                   ; пустой буфер: условный ноль, указатели не трогаем
0083 22             75          ret
                    76  END
                    77  
