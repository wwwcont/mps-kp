                     1  ; Хромов И., А-08-23, 20, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=20 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 20            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 6648h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1608
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 14h          ; флаг пустоты буфера (22h.4)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.6         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.7         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2308 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0FCh
              =1    36  TICK_H       EQU 0C9h          ; тик 14 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 50h
              =1    38  Y1_TICKS     EQU 27           ; T1 = 378 мс
              =1    39  T3_TICKS     EQU 230          ; T3 = 3220 мс
              =1    40  
                     3  DSEG AT 30h
                     4  
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN ; разрешить доступ к внешнему ОЗУ
0030 906000         27          mov DPTR, #BUF_START ; пустой буфер начинается с первого адреса
0033 858240         28          mov HEAD_L, DPL
0036 858341         29          mov HEAD_H, DPH
0039 858242         30          mov TAIL_L, DPL
003C 858343         31          mov TAIL_H, DPH
003F D214           32          setb F_EMPTY ; при совпадении адресов буфер опустел
0041 C21C           33          clr F_OVF ; после чтения появилась свободная ячейка
0043 120048         34          call BufRead ; %proc%
0046 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufRead — чтение самого старого отсчёта из кольцевого буфера.
                    38  ; Вход: нет. Выход: A — отсчёт; F_EMPTY — буфер опустел; F_OVF сброшен (буфер больше не полон).
                    39  ; Для пустого буфера A = 0, флаги и указатели сохраняются. Изменяет DPTR и CY.
0048                40  BufRead:
0048 20142E         41          jb F_EMPTY, Empty ; при пустом буфере чтения нет
004B 854282         42          mov DPL, TAIL_L ; загрузить адрес старейшего отсчёта
004E 854383         43          mov DPH, TAIL_H
0051 E0             44          movx A, @DPTR ; прочитать отсчёт из левого порта ОЗУ
0052 C0E0           45          push ACC ; сохранить отсчёт на время расчёта адреса
0054 A3             46          inc DPTR ; перейти к следующей ячейке
0055 E582           47          mov A, DPL
0057 B44808         48          cjne A, #LOW BUF_END, SaveTail ; сначала проверить младший байт границы
005A E583           49          mov A, DPH
005C B46603         50          cjne A, #HIGH BUF_END, SaveTail ; сравнить старший байт границы
005F 906000         51          mov DPTR, #BUF_START ; пустой буфер начинается с первого адреса
0062                52  SaveTail:
0062 858242         53          mov TAIL_L, DPL
0065 858343         54          mov TAIL_H, DPH
0068 C21C           55          clr F_OVF ; после чтения появилась свободная ячейка
006A E582           56          mov A, DPL
006C B54007         57          cjne A, HEAD_L, ReadDone ; сравнить новый хвост с головой
006F E583           58          mov A, DPH
0071 B54102         59          cjne A, HEAD_H, ReadDone
0074 D214           60          setb F_EMPTY ; при совпадении адресов буфер опустел
0076                61  ReadDone:
0076 D0E0           62          pop ACC ; вернуть прочитанный отсчёт
0078 22             63          ret
0079                64  Empty:
0079 E4             65          clr A
007A 22             66          ret
                    67  END
                    68  
