                     1  ; Хромов И., А-08-23, 20, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=20 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 20            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 6648h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1608
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 14h          ; флаг пустоты буфера (22h.4)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.6         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.7         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2308 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0FCh
              =1    36  TICK_H       EQU 0C9h          ; тик 14 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 50h
              =1    38  Y1_TICKS     EQU 27           ; T1 = 378 мс
              =1    39  T3_TICKS     EQU 230          ; T3 = 3220 мс
              =1    40  
                     3  DSEG AT 30h
                     4  
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN ; разрешить дешифратор внешних устройств
0030 90C000         27          mov DPTR, #ADR_KB ; адрес регистра столбцов и буфера строк
0033 E4             28          clr A ; нулевой код включает все столбцы
0034 F0             29          movx @DPTR, A ; выставить маску столбцов
0035 D288           30          setb IT0 ; внешнее прерывание по спаду
0037 C289           31          clr IE0 ; снять запрос, возникший при переключении столбцов
0039 D2A8           32          setb EX0
003B D2AF           33          setb EA
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — сканирование матрицы клавиатуры по столбцам (обработчик INT0).
                    37  ; Вход: нет. Выход: A — код единственной нажатой клавиши по табл. 3 ТЗ или 0FFh.
                    38  ; Изменяет A, сохраняет PSW, DPTR и R2–R7 (банк 0).
003F                39  KbScan:
003F C0D0           40          push PSW ; сохранить состояние прерванного кода
0041 C082           41          push DPL ; сохранить младший байт указателя
0043 C083           42          push DPH ; сохранить старший байт указателя
0045 C002           43          push 02h ; сохранить R2–R7 из банка 0
0047 C003           44          push 03h
0049 C004           45          push 04h
004B C005           46          push 05h
004D C006           47          push 06h
004F C007           48          push 07h
                    49  
0051 7AFE           50          mov R2, #0FEh           ; ноль только в опрашиваемом столбце
0053 7B04           51          mov R3, #KB_COLS ; опросить все столбцы матрицы
0055 7C00           52          mov R4, #0              ; индекс контакта в таблице
0057 7D00           53          mov R5, #0              ; число замкнутых контактов
0059 7FFF           54          mov R7, #0FFh           ; результат, если замыканий нет
005B                55  ScanCol:
005B 90C000         56          mov DPTR, #ADR_KB ; адрес регистра столбцов и буфера строк
005E EA             57          mov A, R2
005F F0             58          movx @DPTR, A ; выставить маску столбцов
0060 E0             59          movx A, @DPTR ; считать состояния строк
0061 7E03           60          mov R6, #KB_ROWS ; проверять только используемые разряды
0063                61  ScanRow:
0063 13             62          rrc A ; перенести очередную строку в CY
0064 400E           63          jc NextRow ; единица означает разомкнутую строку
0066 0D             64          inc R5
0067 BD0114         65          cjne R5, #1, Several ; второе замыкание уже исключает единственную клавишу
006A C0E0           66          push ACC ; сохранить непрочитанные разряды строк
006C 90009B         67          mov DPTR, #KeyCodes
006F EC             68          mov A, R4
0070 93             69          movc A, @A+DPTR ; найти код по номеру контакта
0071 FF             70          mov R7, A
0072 D0E0           71          pop ACC ; продолжить опрос той же колонки
0074                72  NextRow:
0074 0C             73          inc R4
0075 DEEC           74          djnz R6, ScanRow
0077 EA             75          mov A, R2
0078 23             76          rl A ; перенести ноль на следующий столбец
0079 FA             77          mov R2, A
007A DBDF           78          djnz R3, ScanCol
007C 8002           79          sjmp ScanDone
007E                80  Several:
007E 7FFF           81          mov R7, #0FFh
0080                82  ScanDone:
0080 90C000         83          mov DPTR, #ADR_KB ; адрес регистра столбцов и буфера строк
0083 E4             84          clr A ; нулевой код включает все столбцы
0084 F0             85          movx @DPTR, A           ; вернуть все столбцы в ноль
0085 C289           86          clr IE0 ; снять запрос, возникший при переключении столбцов
0087 EF             87          mov A, R7 ; вернуть код через аккумулятор
0088 D007           88          pop 07h ; восстановить R7–R2
008A D006           89          pop 06h
008C D005           90          pop 05h
008E D004           91          pop 04h
0090 D003           92          pop 03h
0092 D002           93          pop 02h
0094 D083           94          pop DPH
0096 D082           95          pop DPL
0098 D0D0           96          pop PSW ; восстановить флаги прерванной программы
009A 22             97          ret
                    98  
009B                99  KeyCodes:
009B 0104070205080306090A0B00      100          DB 1, 4, 7, 2, 5, 8, 3, 6, 9, 10, 11, 0
                   101  END
                   102  
