                     1  ; Хромов И., А-08-23, 20, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-08, M=20 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 20            ; номер варианта
              =1     4  VAR_G        EQU 8            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0C000h        ; клавиатура: запись столбцов / чтение строк, CS Y6
              =1    10  ADR_Y2       EQU 8000h        ; регистр Y2, CS Y4
              =1    11  BUF_START    EQU 6000h        ; первая ячейка буфера, CS Y3
              =1    12  BUF_END      EQU 6648h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1608
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 40h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 41h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 42h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 43h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 14h          ; флаг пустоты буфера (22h.4)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.6         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.7         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2308 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0FCh
              =1    36  TICK_H       EQU 0C9h          ; тик 14 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 50h
              =1    38  Y1_TICKS     EQU 27           ; T1 = 378 мс
              =1    39  T3_TICKS     EQU 230          ; T3 = 3220 мс
              =1    40  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 — конец строба Y2
001B C28E           18          clr TR1 ; остановить таймер после переполнения
001D D297           19          setb PIN_Y2 ; вернуть строб на пассивный уровень
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h
002E D2B4           28          setb PIN_CSEN ; разрешить запись во внешний регистр
0030 D297           29          setb PIN_Y2 ; вернуть строб на пассивный уровень
0032 758910         30          mov TMOD, #10h ; таймер 1 работает в 16-разрядном режиме
0035 D2BB           31          setb PT1 ; прерывание конца строба имеет высокий приоритет
0037 D2AB           32          setb ET1
0039 D2AF           33          setb EA
003B 753003         34          mov X1, #3              ; пример входных данных
003E 7531C8         35          mov X2, #200
0041 120046         36          call Y2Out ; %proc%
0044 80FE           37          jmp $ ; %stop%
                    38  
                    39  ; Y2Out — расчёт Y2 = (G+M+X1+X2) mod 256 (X1 = 0 → Y2 = 0), запись в регистр Y2 и строб T2.
                    40  ; Вход: X1, X2. Выход: регистр Y2; PIN_Y2 = 0 на T2 мкс (конец — в прерывании Timer1).
                    41  ; Изменяет A, DPTR и флаги арифметики.
0046                42  Y2Out:
0046 E530           43          mov A, X1 ; нулевой X1 сразу даёт нулевой выход
0048 6004           44          jz WriteY2
004A 2531           45          add A, X2
004C 241C           46          add A, #Y2_CONST ; сложение в аккумуляторе даёт остаток по модулю 256
004E                47  WriteY2:
004E 908000         48          mov DPTR, #ADR_Y2
0051 F0             49          movx @DPTR, A ; установить код до активного фронта строба
0052 C28E           50          clr TR1 ; остановить таймер после переполнения
0054 C28F           51          clr TF1 ; снять старый запрос переполнения
0056 758DF6         52          mov TH1, #T2_RELOAD_H ; загрузить старший байт начального счёта
0059 758BFC         53          mov TL1, #T2_RELOAD_L ; загрузить младший байт начального счёта
005C C297           54          clr PIN_Y2 ; выдать активный низкий уровень
005E D28E           55          setb TR1 ; начать отсчёт длительности строба
0060 22             56          ret
                    57  END
                    58  
