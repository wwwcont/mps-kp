; Параметры варианта А-09, M=2 (ТЗ 2026). Сгенерировано mpsgen — не править руками.

VAR_M        EQU 2            ; номер варианта
VAR_G        EQU 9            ; номер группы
Y2_CONST     EQU 11            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256

; --- адреса внешних устройств (movx) ---
ADR_IND      EQU 0C000h        ; индикатор, CS Y6
ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
ADR_Y2       EQU 0A000h        ; регистр Y2, CS Y5
BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
BUF_END      EQU 85F0h        ; первая ячейка ЗА буфером (точка заворота)
BUF_SIZE     EQU 1520

; --- клавиатура 4x3 и индикатор ---
KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)

; --- внутреннее ОЗУ ---
HEAD_L       EQU 44h          ; «голова», младший байт
HEAD_H       EQU 45h          ; «голова», старший байт
TAIL_L       EQU 46h          ; «хвост», младший байт
TAIL_H       EQU 47h          ; «хвост», старший байт
F_EMPTY      BIT 2h          ; флаг пустоты буфера (20h.2)
F_OVF        BIT 0Bh          ; флаг переполнения буфера (21h.3)

; --- выводы ---
PIN_Y1       BIT P1.2         ; строб Y1, активный 0
PIN_Y2       BIT P1.3         ; строб Y2, активный 0
PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)

; --- таймеры (кварц 12 МГц) ---
T2_RELOAD_H  EQU 0F8h          ; строб Y2 1869 мкс, Timer1
T2_RELOAD_L  EQU 0B3h
TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
TICK_L       EQU 78h
Y1_TICKS     EQU 41           ; T1 = 205 мс
T3_TICKS     EQU 476          ; T3 = 2380 мс
