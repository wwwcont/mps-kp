                     1  ; Давыдова Е.П., А-09-23, 2, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=2 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 2            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 11            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0A000h        ; регистр Y2, CS Y5
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85F0h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1520
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 2h          ; флаг пустоты буфера (20h.2)
              =1    27  F_OVF        BIT 0Bh          ; флаг переполнения буфера (21h.3)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.2         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.3         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1869 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0B3h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 41           ; T1 = 205 мс
              =1    40  T3_TICKS     EQU 476          ; T3 = 2380 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; переменных в ОЗУ нет: опрос работает на регистрах R2…R6 и B
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; разрешить дешифратор, чтобы дошёл CS клавиатуры
0030 90E000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; все столбцы в 0: любое нажатие опустит строку и ~INT0
0035 D288           30          setb IT0                ; INT0 — по спаду
0037 C289           31          clr IE0                 ; забыть спад, возможный при установке столбцов
0039 D2A8           32          setb EX0                ; разрешить прерывание от клавиатуры
003B D2AF           33          setb EA                 ; общее разрешение прерываний
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос матрицы 4x3 по столбцам (вызывается из обработчика INT0).
                    37  ; Проходит Col1…Col4, в каждом читает строки и считает замкнутые контакты.
                    38  ; Вход: нет.
                    39  ; Выход: A — код клавиши по табл. 3 ТЗ, если нажата ровно одна; 0FFh — ни одной или несколько.
                    40  ; Портит: только A (PSW, B, DPTR, R2…R6 сохраняются в стеке).
003F                41  KbScan:
003F C0D0           42          push PSW
0041 C0F0           43          push B
0043 C082           44          push DPL
0045 C083           45          push DPH
0047 C002           46          push AR2
0049 C003           47          push AR3
004B C004           48          push AR4
004D C005           49          push AR5
004F C006           50          push AR6
0051 7AFF           51          mov R2, #0FFh           ; код найденной клавиши (пока нет)
0053 7B00           52          mov R3, #0              ; сколько контактов замкнуто
0055 7C00           53          mov R4, #0              ; номер столбца 0…3
0057 7DFE           54          mov R5, #0FEh           ; маска: 0 только в бите текущего столбца
0059                55  KbCol:
0059 90E000         56          mov DPTR, #ADR_KB
005C ED             57          mov A, R5
005D F0             58          movx @DPTR, A           ; опустить один столбец, остальные держать в 1
005E E0             59          movx A, @DPTR           ; прочитать строки через 74HC244
005F F4             60          cpl A                   ; теперь 1 — строка замкнута
0060 5407           61          anl A, #(1 SHL KB_ROWS) - 1 ; старшие линии шины к строкам не подключены
0062 F5F0           62          mov B, A                ; биты замкнутых строк этого столбца
0064 EC             63          mov A, R4
0065 FE             64          mov R6, A               ; индекс в KeyTab: строка * KB_COLS + столбец, начинаем с Row1
0066                65  KbRow:
0066 E5F0           66          mov A, B
0068 6013           67          jz KbNext               ; в столбце больше нет замкнутых строк
006A C3             68          clr C
006B 13             69          rrc A                   ; младшая строка уходит в C
006C F5F0           70          mov B, A
006E 5007           71          jnc KbSkip              ; эта строка не замкнута
0070 0B             72          inc R3                  ; ещё один замкнутый контакт
0071 EE             73          mov A, R6
0072 9000A6         74          mov DPTR, #KeyTab
0075 93             75          movc A, @A+DPTR         ; код клавиши по раскладке рис. 4
0076 FA             76          mov R2, A
0077                77  KbSkip:
0077 EE             78          mov A, R6
0078 2404           79          add A, #KB_COLS         ; та же колонка, следующая строка
007A FE             80          mov R6, A
007B 80E9           81          sjmp KbRow
007D                82  KbNext:
007D ED             83          mov A, R5
007E 23             84          rl A                    ; ноль переезжает на следующий столбец
007F FD             85          mov R5, A
0080 0C             86          inc R4
0081 BC04D5         87          cjne R4, #KB_COLS, KbCol
0084 90E000         88          mov DPTR, #ADR_KB
0087 E4             89          clr A
0088 F0             90          movx @DPTR, A           ; снова все столбцы в 0 — ждём следующее нажатие
0089 C289           91          clr IE0                 ; спады ~INT0 во время перебора — не новое нажатие
008B EA             92          mov A, R2
008C BB0102         93          cjne R3, #1, KbBad      ; ровно одна клавиша — код, иначе ошибка
008F 8002           94          sjmp KbOut
0091                95  KbBad:
0091 74FF           96          mov A, #0FFh            ; ничего не нажато (помеха) или нажато несколько
0093                97  KbOut:
0093 D006           98          pop AR6
0095 D005           99          pop AR5
0097 D004          100          pop AR4
0099 D003          101          pop AR3
009B D002          102          pop AR2
009D D083          103          pop DPH
009F D082          104          pop DPL
00A1 D0F0          105          pop B
00A3 D0D0          106          pop PSW
00A5 22            107          ret
                   108  
                   109  ; KeyTab — коды клавиш (табл. 3 ТЗ) в порядке строка * 4 + столбец, раскладка 4x3 рис. 4:
                   110  ; Row1: 1 2 3 Т, Row2: 4 5 6 С, Row3: 7 8 9 0; Т = 10, С = 11.
00A6 0102030A      111  KeyTab: DB 1, 2, 3, 10
00AA 0405060B      112          DB 4, 5, 6, 11
00AE 07080900      113          DB 7, 8, 9, 0
                   114  END
                   115  
