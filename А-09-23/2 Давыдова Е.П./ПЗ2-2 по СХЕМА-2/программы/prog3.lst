                     1  ; Давыдова Е.П., А-09-23, 2, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=2 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 2            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 11            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0A000h        ; регистр Y2, CS Y5
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85F0h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1520
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 2h          ; флаг пустоты буфера (20h.2)
              =1    27  F_OVF        BIT 0Bh          ; флаг переполнения буфера (21h.3)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.2         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.3         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1869 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0B3h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 41           ; T1 = 205 мс
              =1    40  T3_TICKS     EQU 476          ; T3 = 2380 мс
              =1    41  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 отсчитал T2 — конец строба Y2
001B C28E           18          clr TR1                 ; таймер больше не нужен до следующего вывода
001D D293           19          setb PIN_Y2             ; строб в пассивную 1
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h
002E D2B4           28          setb PIN_CSEN           ; дешифратор включён — дойдёт CS регистра Y2
0030 D293           29          setb PIN_Y2             ; строб Y2 пассивен
0032 758910         30          mov TMOD, #10h          ; Timer1 — режим 1 (16 бит), Timer0 не используется
0035 D2AB           31          setb ET1                ; прерывание по переполнению Timer1
0037 D2AF           32          setb EA
0039 753003         33          mov X1, #3              ; пример входных данных
003C 7531C8         34          mov X2, #200
003F 120044         35          call Y2Out ; %proc%
0042 80FE           36          jmp $ ; %stop%
                    37  
                    38  ; Y2Out — вычислить Y2, записать в регистр Y2 (74HC573) и выдать строб длительностью T2.
                    39  ; Y2 = (G + M + X1 + X2) mod 256, если X1 не 0; при X1 = 0 — Y2 = 0.
                    40  ; Вход: X1, X2 (ОЗУ).
                    41  ; Выход: значение в регистре Y2; PIN_Y2 = 0, Timer1 запущен на T2 (строб снимает его прерывание).
                    42  ; Портит: A (PSW и DPTR сохраняются в стеке).
0044                43  Y2Out:
0044 C0D0           44          push PSW
0046 C082           45          push DPL
0048 C083           46          push DPH
004A E530           47          mov A, X1
004C 6004           48          jz Y2Put                ; X1 = 0 — выводим 0
004E 2531           49          add A, X2               ; перенос отбрасывается: это и есть mod 256
0050 240B           50          add A, #Y2_CONST        ; + (G + M)
0052                51  Y2Put:
0052 90A000         52          mov DPTR, #ADR_Y2
0055 F0             53          movx @DPTR, A           ; сначала значение в регистр
0056 C28E           54          clr TR1                 ; на случай незавершённого прошлого строба
0058 758DF8         55          mov TH1, #T2_RELOAD_H   ; Timer1 отсчитает T2
005B 758BB3         56          mov TL1, #T2_RELOAD_L
005E C28F           57          clr TF1                 ; убрать старое переполнение
0060 C293           58          clr PIN_Y2              ; начало строба
0062 D28E           59          setb TR1                ; пошёл отсчёт T2
0064 D083           60          pop DPH
0066 D082           61          pop DPL
0068 D0D0           62          pop PSW
006A 22             63          ret
                    64  END
                    65  
