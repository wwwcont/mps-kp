                     1  ; Давыдова Е.П., А-09-23, 2, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=2 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 2            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 11            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0A000h        ; регистр Y2, CS Y5
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85F0h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1520
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 2h          ; флаг пустоты буфера (20h.2)
              =1    26  F_OVF        BIT 0Bh          ; флаг переполнения буфера (21h.3)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.2         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.3         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1869 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0B3h
              =1    36  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 78h
              =1    38  Y1_TICKS     EQU 41           ; T1 = 205 мс
              =1    39  T3_TICKS     EQU 476          ; T3 = 2380 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; своих переменных нет: указатели и флаги — по адресам из vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор включён — CS буфера будет работать
0030 754400         27          mov HEAD_L, #LOW(BUF_START)  ; запись пойдёт в первую ячейку буфера
0033 754580         28          mov HEAD_H, #HIGH(BUF_START)
0036 754600         29          mov TAIL_L, #LOW(BUF_START)  ; читать тоже начнём с первой ячейки
0039 754780         30          mov TAIL_H, #HIGH(BUF_START)
003C D202           31          setb F_EMPTY            ; буфер пуст
003E C20B           32          clr F_OVF               ; переполнения не было
0040 120045         33          call BufRead ; %proc%
0043 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; BufRead — выдать самый старый отсчёт из кольцевого буфера (IDT7005, левый порт).
                    37  ; Вход: «хвост» TAIL_H:TAIL_L, «голова» HEAD_H:HEAD_L, флаг F_EMPTY.
                    38  ; Выход: A — отсчёт; «хвост» сдвинут на ячейку (после BUF_END-1 — на BUF_START);
                    39  ;        F_OVF = 0; F_EMPTY = 1, если «хвост» догнал «голову».
                    40  ;        Пустой буфер: A = 0, указатели и флаги не меняются.
                    41  ; Портит: только A (PSW и DPTR сохраняются в стеке).
0045                42  BufRead:
0045 20023A         43          jb F_EMPTY, BrNone      ; читать нечего
0048 C0D0           44          push PSW
004A C082           45          push DPL
004C C083           46          push DPH
004E 854682         47          mov DPL, TAIL_L
0051 854783         48          mov DPH, TAIL_H
0054 E0             49          movx A, @DPTR           ; самый старый отсчёт
0055 C0E0           50          push ACC                ; сберечь его, пока двигаем «хвост»
0057 A3             51          inc DPTR                ; следующая ячейка
0058 E582           52          mov A, DPL
005A B4F008         53          cjne A, #LOW(BUF_END), BrKeep   ; ещё не вышли за буфер
005D E583           54          mov A, DPH
005F B48503         55          cjne A, #HIGH(BUF_END), BrKeep
0062 908000         56          mov DPTR, #BUF_START    ; вышли за последнюю ячейку — на начало кольца
0065                57  BrKeep:
0065 858246         58          mov TAIL_L, DPL
0068 858347         59          mov TAIL_H, DPH
006B C20B           60          clr F_OVF               ; одна ячейка освободилась — буфер не полон
006D E546           61          mov A, TAIL_L
006F B54407         62          cjne A, HEAD_L, BrDone  ; «хвост» не совпал с «головой» — данные ещё есть
0072 E547           63          mov A, TAIL_H
0074 B54502         64          cjne A, HEAD_H, BrDone
0077 D202           65          setb F_EMPTY            ; прочитан последний отсчёт
0079                66  BrDone:
0079 D0E0           67          pop ACC                 ; вернуть отсчёт в A
007B D083           68          pop DPH
007D D082           69          pop DPL
007F D0D0           70          pop PSW
0081 22             71          ret
0082                72  BrNone:
0082 E4             73          clr A                   ; пусто: отдать 0, ничего не трогать
0083 22             74          ret
                    75  END
                    76  
