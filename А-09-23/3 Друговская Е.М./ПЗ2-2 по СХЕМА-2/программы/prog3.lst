                     1  ; Друговская Е.М., А-09-23, 3, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=3 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 3            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 12            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85FAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1530
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 3h          ; флаг пустоты буфера (20h.3)
              =1    27  F_OVF        BIT 0Ch          ; флаг переполнения буфера (21h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1899 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 95h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 43           ; T1 = 215 мс
              =1    40  T3_TICKS     EQU 486          ; T3 = 2430 мс
              =1    41  
                     3  T0_LOAD EQU (TICK_H SHL 8) + TICK_L + 7   ; загрузка тика 5 мс + 7 циклов, пока таймер стоит в обработчике
                     4  DSEG AT 30h
                     5  T3Cnt:  DS 2                    ; сколько тиков по 5 мс осталось до гашения (младший, старший байт)
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh                         ; Timer0 — тик для отсчёта T3
000B 020071         12          ljmp T0Isr
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор включён — регистр индикатора доступен
0030 90A000         27          mov DPTR, #ADR_IND
0033 74FF           28          mov A, #IND_OFF
0035 F0             29          movx @DPTR, A           ; после сброса индикатор тёмный
0036 758911         30          mov TMOD, #11h          ; оба таймера — 16-разрядные (режим 1)
0039 D2A9           31          setb ET0                ; прерывание Timer0 — отсчёт T3
003B D2AF           32          setb EA
003D 7405           33          mov A, #5               ; пример: показать «5»
003F 120044         34          call Show ; %proc%
0042 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; Show — вывод символа на индикатор (общий анод) на время T3; гасит его обработчик Timer0.
                    38  ; Вход: A — код по табл. 2 ТЗ: 0–9 — цифра, 10 — «E», больше — погасить.
                    39  ; Выход: символ в регистре индикатора; для 0–10 заново запущен отсчёт T3.
                    40  ; Портит: A, DPTR, PSW.
0044                41  Show:
0044 B40B00         42          cjne A, #11, $+3        ; C = 1, если код меньше 11
0047 501F           43          jnc ShBlank             ; 11 и больше — показывать нечего
0049 9000A8         44          mov DPTR, #SegTab
004C 93             45          movc A, @A+DPTR         ; код символа -> сегменты
004D 90A000         46          mov DPTR, #ADR_IND
0050 F0             47          movx @DPTR, A           ; символ загорается
0051 C28C           48          clr TR0                 ; старый отсчёт (если шёл) отменяем
0053 C2A9           49          clr ET0                 ; счётчик меняем без помех от прерывания
0055 7530E6         50          mov T3Cnt, #LOW(T3_TICKS)
0058 753101         51          mov T3Cnt+1, #HIGH(T3_TICKS)
005B 758CEC         52          mov TH0, #TICK_H        ; первый тик 5 мс
005E 758A78         53          mov TL0, #TICK_L
0061 C28D           54          clr TF0
0063 D2A9           55          setb ET0
0065 D28C           56          setb TR0                ; пошёл отсчёт T3
0067 22             57          ret
0068                58  ShBlank:
0068 74FF           59          mov A, #IND_OFF
006A 90A000         60          mov DPTR, #ADR_IND
006D F0             61          movx @DPTR, A           ; гасим индикатор сразу
006E C28C           62          clr TR0                 ; отсчёт T3 больше не нужен
0070 22             63          ret
                    64  
                    65  ; T0Isr — тик Timer0 (5 мс): перезагрузка таймера с поправкой, счёт тиков T3,
                    66  ; по окончании T3 — индикатор гаснет и таймер останавливается.
                    67  ; Вход: T3Cnt. Выход: T3Cnt уменьшен. Портит: ничего (A, PSW, DPTR сохраняются).
0071                68  T0Isr:
0071 C0E0           69          push ACC
0073 C0D0           70          push PSW
0075 C28C           71          clr TR0                 ; на время перезагрузки таймер стоит
0077 E58A           72          mov A, TL0              ; TL0/TH0 уже набежали после переполнения — прибавляем к ним
0079 247F           73          add A, #LOW(T0_LOAD)
007B F58A           74          mov TL0, A
007D E58C           75          mov A, TH0
007F 34EC           76          addc A, #HIGH(T0_LOAD)
0081 F58C           77          mov TH0, A
0083 D28C           78          setb TR0
0085 E530           79          mov A, T3Cnt            ; T3Cnt := T3Cnt - 1 (16 бит)
0087 7002           80          jnz T0Low
0089 1531           81          dec T3Cnt+1
008B                82  T0Low:
008B 1530           83          dec T3Cnt
008D E530           84          mov A, T3Cnt
008F 4531           85          orl A, T3Cnt+1
0091 7010           86          jnz T0Exit              ; T3 ещё не кончилось
0093 C28C           87          clr TR0                 ; T3 вышло — таймер больше не нужен
0095 C082           88          push DPL
0097 C083           89          push DPH
0099 90A000         90          mov DPTR, #ADR_IND
009C 74FF           91          mov A, #IND_OFF
009E F0             92          movx @DPTR, A           ; гасим индикатор
009F D083           93          pop DPH
00A1 D082           94          pop DPL
00A3                95  T0Exit:
00A3 D0D0           96          pop PSW
00A5 D0E0           97          pop ACC
00A7 32             98          reti
                    99  
                   100  ; Сегменты для общего анода (0 — сегмент горит; D0…D7 = a…g, dp): цифры 0–9 и «E».
00A8 C0F9A4B099      101  SegTab: DB 0C0h, 0F9h, 0A4h, 0B0h, 099h
00AD 9282F88090      102          DB 092h, 082h, 0F8h, 080h, 090h
00B2 86            103          DB 086h
                   104  END
                   105  
