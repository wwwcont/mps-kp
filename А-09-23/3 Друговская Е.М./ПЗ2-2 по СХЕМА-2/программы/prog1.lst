                     1  ; Друговская Е.М., А-09-23, 3, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=3 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 3            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 12            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85FAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1530
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 3h          ; флаг пустоты буфера (20h.3)
              =1    27  F_OVF        BIT 0Ch          ; флаг переполнения буфера (21h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1899 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 95h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 43           ; T1 = 215 мс
              =1    40  T3_TICKS     EQU 486          ; T3 = 2430 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; переменные не нужны: всё держится в регистрах на время опроса
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003D          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; включаем дешифратор, иначе ни одно устройство не выбирается
0030 90E000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; все столбцы опущены: любое нажатие сразу опустит строку и даст INT0
0035 D288           30          setb IT0                ; INT0 срабатывает по спаду
0037 D2A8           31          setb EX0                ; прерывание от клавиатуры разрешено
0039 D2AF           32          setb EA                 ; общее разрешение прерываний
003B 80FE           33          jmp $ ; %stop%
                    34  
                    35  ; KbScan — опрос матрицы клавиатуры 3x4 по столбцам (вызывается из обработчика INT0).
                    36  ; Вход: нет.
                    37  ; Выход: A — код нажатой клавиши (0–9, «Т» = 10, «С» = 11) или 0FFh, если нажато
                    38  ;        не ровно одна клавиша. Столбцы после опроса снова все в 0, IE0 сброшен.
                    39  ; Портит: A, B, DPTR, PSW (R2–R7 сохраняются в стеке).
003D                40  KbScan:
003D C002           41          push AR2
003F C003           42          push AR3
0041 C004           43          push AR4
0043 C005           44          push AR5
0045 C006           45          push AR6
0047 C007           46          push AR7
0049 7A00           47          mov R2, #0              ; сколько замкнутых контактов нашли
004B 7BFF           48          mov R3, #0FFh           ; номер найденной клавиши в таблице KeyTab
004D 7CFE           49          mov R4, #0FEh           ; маска столбцов: ноль стоит в Col1
004F 7D00           50          mov R5, #0              ; номер текущего столбца
0051 90E000         51          mov DPTR, #ADR_KB
0054                52  KsCol:
0054 EC             53          mov A, R4
0055 F0             54          movx @DPTR, A           ; опускаем только текущий столбец
0056 E0             55          movx A, @DPTR           ; читаем строки
0057 540F           56          anl A, #(1 SHL KB_ROWS) - 1   ; старшие линии шины не подключены — отбрасываем
0059 640F           57          xrl A, #(1 SHL KB_ROWS) - 1   ; теперь 1 означает «строка замкнута»
005B FE             58          mov R6, A               ; замкнутые строки этого столбца
005C ED             59          mov A, R5
005D FF             60          mov R7, A               ; номер клавиши в строке Row1 этого столбца
005E 75F004         61          mov B, #KB_ROWS         ; проверим каждую строку
0061                62  KsRow:
0061 EE             63          mov A, R6
0062 13             64          rrc A                   ; очередная строка уходит в C
0063 FE             65          mov R6, A
0064 5003           66          jnc KsSkip              ; эта строка не замкнута
0066 0A             67          inc R2                  ; ещё одно нажатие
0067 EF             68          mov A, R7
0068 FB             69          mov R3, A               ; запоминаем, какая клавиша
0069                70  KsSkip:
0069 EF             71          mov A, R7
006A 2403           72          add A, #KB_COLS         ; в следующей строке номер больше на число столбцов
006C FF             73          mov R7, A
006D D5F0F1         74          djnz B, KsRow
0070 EC             75          mov A, R4
0071 23             76          rl A                    ; ноль маски переезжает в следующий столбец
0072 FC             77          mov R4, A
0073 0D             78          inc R5
0074 BD03DD         79          cjne R5, #KB_COLS, KsCol
0077 E4             80          clr A
0078 F0             81          movx @DPTR, A           ; все столбцы снова опущены — ждём следующего нажатия
0079 C289           82          clr IE0                 ; при переборе столбцов линия INT0 дёргалась — лишний запрос гасим
007B 74FF           83          mov A, #0FFh            ; по умолчанию — ошибка
007D BA0105         84          cjne R2, #1, KsDone     ; ноль или несколько нажатий — оставляем 0FFh
0080 EB             85          mov A, R3
0081 900092         86          mov DPTR, #KeyTab
0084 93             87          movc A, @A+DPTR         ; номер клавиши -> её код по табл. 3 ТЗ
0085                88  KsDone:
0085 D007           89          pop AR7
0087 D006           90          pop AR6
0089 D005           91          pop AR5
008B D004           92          pop AR4
008D D003           93          pop AR3
008F D002           94          pop AR2
0091 22             95          ret
                    96  
                    97  ; Коды клавиш по номеру (строка * 3 + столбец), раскладка 3x4 рис. 4 ТЗ.
0092 010203         98  KeyTab: DB 1, 2, 3
0095 040506         99          DB 4, 5, 6
0098 070809        100          DB 7, 8, 9
009B 000A0B        101          DB 0, 10, 11
                   102  END
                   103  
