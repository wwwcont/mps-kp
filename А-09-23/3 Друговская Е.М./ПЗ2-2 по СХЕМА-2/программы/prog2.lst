                     1  ; Друговская Е.М., А-09-23, 3, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=3 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 3            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 12            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85FAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1530
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 3h          ; флаг пустоты буфера (20h.3)
              =1    27  F_OVF        BIT 0Ch          ; флаг переполнения буфера (21h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1899 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 95h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 43           ; T1 = 215 мс
              =1    40  T3_TICKS     EQU 486          ; T3 = 2430 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; переменные не нужны: указатели и флаги буфера заданы в vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор включён — буфер доступен по movx
0030 754400         27          mov HEAD_L, #LOW(BUF_START)   ; писать будем с первой ячейки кольца
0033 754580         28          mov HEAD_H, #HIGH(BUF_START)
0036 754600         29          mov TAIL_L, #LOW(BUF_START)   ; читать — тоже с первой: голова = хвост
0039 754780         30          mov TAIL_H, #HIGH(BUF_START)
003C D203           31          setb F_EMPTY            ; отсчётов в буфере нет
003E C20C           32          clr F_OVF               ; ничего не потеряно
0040 7455           33          mov A, #55h             ; пример отсчёта
0042 120047         34          call BufWrite ; %proc%
0045 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufWrite — запись отсчёта в кольцевой буфер в ячейку «головы».
                    38  ; Если буфер уже полон (голова догнала хвост, буфер не пуст), самый старый
                    39  ; отсчёт теряется: хвост уходит на следующую ячейку, F_OVF = 1.
                    40  ; Вход: A — отсчёт.
                    41  ; Выход: отсчёт в буфере, голова сдвинута, F_EMPTY = 0; F_OVF = 1 при затирании.
                    42  ; Портит: DPTR, PSW (A сохраняется).
0047                43  BufWrite:
0047 C0E0           44          push ACC                ; отсчёт понадобится после проверок
0049 20031B         45          jb F_EMPTY, BwPut       ; пустой буфер полным быть не может
004C E544           46          mov A, HEAD_L
004E B54616         47          cjne A, TAIL_L, BwPut   ; голова не на хвосте — место есть
0051 E545           48          mov A, HEAD_H
0053 B54711         49          cjne A, TAIL_H, BwPut
0056 854682         50          mov DPL, TAIL_L         ; буфер полон: выбрасываем самый старый отсчёт
0059 854783         51          mov DPH, TAIL_H
005C 12007C         52          call PtrStep
005F 858246         53          mov TAIL_L, DPL
0062 858347         54          mov TAIL_H, DPH
0065 D20C           55          setb F_OVF              ; отмечаем, что отсчёт потерян
0067                56  BwPut:
0067 854482         57          mov DPL, HEAD_L         ; адрес ячейки «головы»
006A 854583         58          mov DPH, HEAD_H
006D D0E0           59          pop ACC
006F F0             60          movx @DPTR, A           ; кладём отсчёт левым портом IDT7005
0070 12007C         61          call PtrStep
0073 858244         62          mov HEAD_L, DPL         ; голова — на следующую свободную ячейку
0076 858345         63          mov HEAD_H, DPH
0079 C203           64          clr F_EMPTY             ; теперь в буфере точно что-то есть
007B 22             65          ret
                    66  
                    67  ; PtrStep — переход указателя буфера на следующую ячейку кольца.
                    68  ; Вход: DPTR — адрес ячейки буфера.
                    69  ; Выход: DPTR — следующая ячейка; после последней (BUF_END - 1) — BUF_START.
                    70  ; Портит: PSW (A сохраняется).
007C                71  PtrStep:
007C C0E0           72          push ACC
007E A3             73          inc DPTR
007F E582           74          mov A, DPL
0081 B4FA08         75          cjne A, #LOW(BUF_END), PsDone   ; не дошли до конца кольца
0084 E583           76          mov A, DPH
0086 B48503         77          cjne A, #HIGH(BUF_END), PsDone
0089 908000         78          mov DPTR, #BUF_START    ; вышли за последнюю ячейку — заворачиваем на начало
008C                79  PsDone:
008C D0E0           80          pop ACC
008E 22             81          ret
                    82  END
                    83  
