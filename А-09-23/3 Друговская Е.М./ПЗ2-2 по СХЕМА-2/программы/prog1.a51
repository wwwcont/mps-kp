; Друговская Е.М., А-09-23, 3, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
; переменные не нужны: всё держится в регистрах на время опроса
CSEG AT 0h
        sjmp START
org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
        call KbScan ; %proc%
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh ; "заглушка" для Tmr1_ovf
        nop
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h
        setb PIN_CSEN           ; включаем дешифратор, иначе ни одно устройство не выбирается
        mov DPTR, #ADR_KB
        clr A
        movx @DPTR, A           ; все столбцы опущены: любое нажатие сразу опустит строку и даст INT0
        setb IT0                ; INT0 срабатывает по спаду
        setb EX0                ; прерывание от клавиатуры разрешено
        setb EA                 ; общее разрешение прерываний
        jmp $ ; %stop%

; KbScan — опрос матрицы клавиатуры 3x4 по столбцам (вызывается из обработчика INT0).
; Вход: нет.
; Выход: A — код нажатой клавиши (0–9, «Т» = 10, «С» = 11) или 0FFh, если нажато
;        не ровно одна клавиша. Столбцы после опроса снова все в 0, IE0 сброшен.
; Портит: A, B, DPTR, PSW (R2–R7 сохраняются в стеке).
KbScan:
        push AR2
        push AR3
        push AR4
        push AR5
        push AR6
        push AR7
        mov R2, #0              ; сколько замкнутых контактов нашли
        mov R3, #0FFh           ; номер найденной клавиши в таблице KeyTab
        mov R4, #0FEh           ; маска столбцов: ноль стоит в Col1
        mov R5, #0              ; номер текущего столбца
        mov DPTR, #ADR_KB
KsCol:
        mov A, R4
        movx @DPTR, A           ; опускаем только текущий столбец
        movx A, @DPTR           ; читаем строки
        anl A, #(1 SHL KB_ROWS) - 1   ; старшие линии шины не подключены — отбрасываем
        xrl A, #(1 SHL KB_ROWS) - 1   ; теперь 1 означает «строка замкнута»
        mov R6, A               ; замкнутые строки этого столбца
        mov A, R5
        mov R7, A               ; номер клавиши в строке Row1 этого столбца
        mov B, #KB_ROWS         ; проверим каждую строку
KsRow:
        mov A, R6
        rrc A                   ; очередная строка уходит в C
        mov R6, A
        jnc KsSkip              ; эта строка не замкнута
        inc R2                  ; ещё одно нажатие
        mov A, R7
        mov R3, A               ; запоминаем, какая клавиша
KsSkip:
        mov A, R7
        add A, #KB_COLS         ; в следующей строке номер больше на число столбцов
        mov R7, A
        djnz B, KsRow
        mov A, R4
        rl A                    ; ноль маски переезжает в следующий столбец
        mov R4, A
        inc R5
        cjne R5, #KB_COLS, KsCol
        clr A
        movx @DPTR, A           ; все столбцы снова опущены — ждём следующего нажатия
        clr IE0                 ; при переборе столбцов линия INT0 дёргалась — лишний запрос гасим
        mov A, #0FFh            ; по умолчанию — ошибка
        cjne R2, #1, KsDone     ; ноль или несколько нажатий — оставляем 0FFh
        mov A, R3
        mov DPTR, #KeyTab
        movc A, @A+DPTR         ; номер клавиши -> её код по табл. 3 ТЗ
KsDone:
        pop AR7
        pop AR6
        pop AR5
        pop AR4
        pop AR3
        pop AR2
        ret

; Коды клавиш по номеру (строка * 3 + столбец), раскладка 3x4 рис. 4 ТЗ.
KeyTab: DB 1, 2, 3
        DB 4, 5, 6
        DB 7, 8, 9
        DB 0, 10, 11
END
