                     1  ; Друговская Е.М., А-09-23, 3, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-09, M=3 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 3            ; номер варианта
              =1     4  VAR_G        EQU 9            ; номер группы
              =1     5  Y2_CONST     EQU 12            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0A000h        ; индикатор, CS Y5
              =1     9  ADR_KB       EQU 0E000h        ; клавиатура: запись столбцов / чтение строк, CS Y7
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 8000h        ; первая ячейка буфера, CS Y4
              =1    12  BUF_END      EQU 85FAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1530
              =1    14  BUF_X2IN     EQU 9FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 44h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 45h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 46h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 47h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 3h          ; флаг пустоты буфера (20h.3)
              =1    27  F_OVF        BIT 0Ch          ; флаг переполнения буфера (21h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F8h          ; строб Y2 1899 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 95h
              =1    37  TICK_H       EQU 0ECh          ; тик 5 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 78h
              =1    39  Y1_TICKS     EQU 43           ; T1 = 215 мс
              =1    40  T3_TICKS     EQU 486          ; T3 = 2430 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; здесь объявление переменных (если нужны)
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
                    26          ; TODO: CS_EN = 1; буфер пуст: HEAD = TAIL = BUF_START, F_EMPTY = 1, F_OVF = 0
002E 7455           27          mov A, #55h             ; пример отсчёта
0030 120035         28          call BufWrite ; %proc%
0033 80FE           29          jmp $ ; %stop%
                    30  
                    31  ; BufWrite — запись отсчёта в кольцевой буфер; если буфер полон — затирается самый старый.
                    32  ; Вход: A — отсчёт. Выход: F_EMPTY = 0; F_OVF = 1, если отсчёт затёр самый старый.
                    33  ; TODO: что портит
0035                34  BufWrite:
                    35          ; TODO: полон (HEAD = TAIL, F_EMPTY = 0) — сдвинуть TAIL и F_OVF = 1; movx по адресу HEAD, HEAD дальше (BUF_END → BUF_START)
0035 22             36          ret
                    37  END
                    38  
