; Параметры варианта А-17, M=8 (ТЗ 2026). Сгенерировано mpsgen — не править руками.

VAR_M        EQU 8            ; номер варианта
VAR_G        EQU 17            ; номер группы
Y2_CONST     EQU 25            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256

; --- адреса внешних устройств (movx) ---
ADR_IND      EQU 2000h        ; индикатор, CS Y1
ADR_KB       EQU 4000h        ; клавиатура: запись столбцов / чтение строк, CS Y2
ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
BUF_START    EQU 0C000h        ; первая ячейка буфера, CS Y6
BUF_END      EQU 0C6FCh        ; первая ячейка ЗА буфером (точка заворота)
BUF_SIZE     EQU 1788

; --- клавиатура 4x3 и индикатор ---
KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)

; --- внутреннее ОЗУ ---
HEAD_L       EQU 4Bh          ; «голова», младший байт
HEAD_H       EQU 4Ch          ; «голова», старший байт
TAIL_L       EQU 4Dh          ; «хвост», младший байт
TAIL_H       EQU 4Eh          ; «хвост», старший байт
F_EMPTY      BIT 8h          ; флаг пустоты буфера (21h.0)
F_OVF        BIT 19h          ; флаг переполнения буфера (23h.1)

; --- выводы ---
PIN_Y1       BIT P1.1         ; строб Y1, активный 0
PIN_Y2       BIT P1.2         ; строб Y2, активный 0
PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)

; --- таймеры (кварц 12 МГц) ---
T2_RELOAD_H  EQU 0F7h          ; строб Y2 2257 мкс, Timer1
T2_RELOAD_L  EQU 2Fh
TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
TICK_L       EQU 18h
Y1_TICKS     EQU 277           ; T1 = 277 мс
T3_TICKS     EQU 2535          ; T3 = 2535 мс
