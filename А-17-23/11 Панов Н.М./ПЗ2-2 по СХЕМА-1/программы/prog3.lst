                     1  ; Панов Н.М., А-17-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты и константы варианта
              =1     1  ; Параметры варианта А-17, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 17            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 4000h        ; клавиатура: запись столбцов / чтение строк, CS Y2
              =1    10  ADR_Y2       EQU 2000h        ; регистр Y2, CS Y1
              =1    11  BUF_START    EQU 0C000h        ; первая ячейка буфера, CS Y6
              =1    12  BUF_END      EQU 0C71Ah        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1818
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 4Bh          ; «голова», младший байт
              =1    22  HEAD_H       EQU 4Ch          ; «голова», старший байт
              =1    23  TAIL_L       EQU 4Dh          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Eh          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2347 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0D5h
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 307           ; T1 = 307 мс
              =1    39  T3_TICKS     EQU 2685          ; T3 = 2685 мс
              =1    40  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 — истекло время строба Y2
001B C28E           18          clr TR1                 ; останавливаем таймер
001D D295           19          setb PIN_Y2             ; строб снова пассивен (1)
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h
002E D2B4           28          setb PIN_CSEN           ; дешифратор CS включён
0030 D295           29          setb PIN_Y2             ; строб Y2 пока не активен
0032 53890F         30          anl TMOD, #0Fh          ; сохраняем режим Timer0
0035 438910         31          orl TMOD, #10h          ; Timer1 — 16-битный режим 1
0038 D2AB           32          setb ET1                ; прерывание по переполнению Timer1
003A D2AF           33          setb EA                 ; разрешаем прерывания
003C 753003         34          mov X1, #3              ; пример входных данных
003F 7531C8         35          mov X2, #200
0042 120047         36          call Y2Out ; %proc%
0045 80FE           37          jmp $ ; %stop%
                    38  
                    39  ; Y2Out — расчёт и выдача Y2 = (G+M+X1+X2) mod 256; при X1=0 Y2=0.
                    40  ; Вход: X1, X2 в ОЗУ. Выход: регистр Y2; PIN_Y2 = 0 на T2 мкс
                    41  ; (окончание строба выполняет обработчик Timer1).
                    42  ; Портит: A, DPTR, PSW (сохраняются в стеке).
0047                43  Y2Out:
0047 C0D0           44          push PSW
0049 C0E0           45          push ACC
004B C082           46          push DPL
004D C083           47          push DPH
004F E530           48          mov A, X1
0051 6008           49          jz Y2Zero               ; X1 = 0 — пассивное состояние
0053 741C           50          mov A, #Y2_CONST        ; G + M
0055 2530           51          add A, X1
0057 2531           52          add A, X2               ; перенос отбрасывается: результат mod 256
0059 8001           53          sjmp Y2Write
005B                54  Y2Zero:
005B E4             55          clr A                   ; Y2 = 0
005C                56  Y2Write:
005C 902000         57          mov DPTR, #ADR_Y2
005F F0             58          movx @DPTR, A           ; сначала данные в регистр Y2
0060 C28E           59          clr TR1                 ; перезапуск, если прошлый строб ещё шёл
0062 758DF6         60          mov TH1, #T2_RELOAD_H
0065 758BD5         61          mov TL1, #T2_RELOAD_L
0068 C28F           62          clr TF1                 ; старый запрос переполнения не нужен
006A C295           63          clr PIN_Y2              ; начало строба
006C D28E           64          setb TR1
006E D083           65          pop DPH
0070 D082           66          pop DPL
0072 D0E0           67          pop ACC
0074 D0D0           68          pop PSW
0076 22             69          ret
                    70  END
                    71  
