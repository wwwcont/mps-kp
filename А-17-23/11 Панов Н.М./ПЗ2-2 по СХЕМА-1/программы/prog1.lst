                     1  ; Панов Н.М., А-17-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты и константы варианта
              =1     1  ; Параметры варианта А-17, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 17            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 4000h        ; клавиатура: запись столбцов / чтение строк, CS Y2
              =1    10  ADR_Y2       EQU 2000h        ; регистр Y2, CS Y1
              =1    11  BUF_START    EQU 0C000h        ; первая ячейка буфера, CS Y6
              =1    12  BUF_END      EQU 0C71Ah        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1818
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 4Bh          ; «голова», младший байт
              =1    22  HEAD_H       EQU 4Ch          ; «голова», старший байт
              =1    23  TAIL_L       EQU 4Dh          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Eh          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2347 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0D5h
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 307           ; T1 = 307 мс
              =1    39  T3_TICKS     EQU 2685          ; T3 = 2685 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; отдельных переменных нет: состояние опроса держим в регистрах банка 0
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: обработчик вызывает опрос
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор CS включён
0030 904000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; все столбцы опущены: нажатие сразу даст INT0
0035 D288           30          setb IT0                ; INT0 — по спаду
0037 C289           31          clr IE0                 ; сбрасываем возможный старый запрос
0039 D2A8           32          setb EX0                ; разрешаем прерывание клавиатуры
003B D2AF           33          setb EA                 ; разрешаем прерывания
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос матрицы клавиатуры 3x4 по столбцам.
                    37  ; Вход: нет. Выход: A — код единственной нажатой клавиши (0…9, Т=10, С=11)
                    38  ; или 0FFh, если нажато ничего либо две и более клавиш.
                    39  ; Портит: A, B, DPTR, PSW; регистры R2–R7 восстанавливаются из стека.
003F                40  KbScan:
003F C0D0           41          push PSW
0041 C0F0           42          push B
0043 C082           43          push DPL
0045 C083           44          push DPH
0047 C002           45          push AR2
0049 C003           46          push AR3
004B C004           47          push AR4
004D C005           48          push AR5
004F C006           49          push AR6
0051 C007           50          push AR7
0053 904000         51          mov DPTR, #ADR_KB
0056 7A00           52          mov R2, #0              ; число найденных нажатий
0058 7BFF           53          mov R3, #0FFh           ; код последней найденной клавиши
005A 7CFE           54          mov R4, #0FEh           ; маска столбцов: 0 — опрашиваемый
005C 7D00           55          mov R5, #0              ; номер столбца 0…KB_COLS-1
005E                56  KsCol:
005E EC             57          mov A, R4
005F F0             58          movx @DPTR, A           ; опускаем только текущий столбец
0060 E0             59          movx A, @DPTR           ; читаем строки
0061 540F           60          anl A, #(1 SHL KB_ROWS) - 1     ; старшие биты шины не подключены
0063 640F           61          xrl A, #(1 SHL KB_ROWS) - 1     ; 1 — строка замкнута
0065 FE             62          mov R6, A               ; битовая карта строк
0066 7F00           63          mov R7, #0              ; номер строки
0068                64  KsRow:
0068 EE             65          mov A, R6
0069 5401           66          anl A, #1               ; проверяем младшую (текущую) строку
006B 601D           67          jz KsRowNext
006D 0A             68          inc R2                  ; нашли ещё одно нажатие
006E BF0311         69          cjne R7, #KB_ROWS - 1, KsCalc
                    70          ; четвёртая строка: клавиши 0, Т, С
0071 ED             71          mov A, R5
0072 6007           72          jz KsZero
0074 B40107         73          cjne A, #1, KsTest
0077 740A           74          mov A, #10              ; «Т»
0079 800E           75          sjmp KsSave
007B                76  KsZero:
007B E4             77          clr A                   ; «0»
007C 800B           78          sjmp KsSave
007E                79  KsTest:
007E 740B           80          mov A, #11              ; «С»
0080 8007           81          sjmp KsSave
0082                82  KsCalc:
                    83          ; строки 1–3: код = номер_строки*KB_COLS + номер_столбца + 1
0082 EF             84          mov A, R7
0083 75F003         85          mov B, #KB_COLS
0086 A4             86          mul AB
0087 2D             87          add A, R5
0088 04             88          inc A
0089                89  KsSave:
0089 FB             90          mov R3, A
008A                91  KsRowNext:
008A EE             92          mov A, R6
008B 03             93          rr A                    ; переходим к следующей строке
008C FE             94          mov R6, A
008D 0F             95          inc R7
008E BF04D7         96          cjne R7, #KB_ROWS, KsRow
0091 EC             97          mov A, R4
0092 23             98          rl A                    ; следующий столбец
0093 FC             99          mov R4, A
0094 0D            100          inc R5
0095 BD03C6        101          cjne R5, #KB_COLS, KsCol
0098 E4            102          clr A
0099 F0            103          movx @DPTR, A           ; после опроса все столбцы снова опущены
009A EB            104          mov A, R3
009B BA0102        105          cjne R2, #1, KsBad      ; ровно одно нажатие — отдаём код
009E 8002          106          sjmp KsDone
00A0               107  KsBad:
00A0 74FF          108          mov A, #0FFh            ; ничего или несколько клавиш
00A2               109  KsDone:
00A2 C289          110          clr IE0                 ; линия INT0 дёргалась при переборе столбцов
00A4 D007          111          pop AR7
00A6 D006          112          pop AR6
00A8 D005          113          pop AR5
00AA D004          114          pop AR4
00AC D003          115          pop AR3
00AE D002          116          pop AR2
00B0 D083          117          pop DPH
00B2 D082          118          pop DPL
00B4 D0F0          119          pop B
00B6 D0D0          120          pop PSW
00B8 22            121          ret
                   122  END
                   123  
