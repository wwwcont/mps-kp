                     1  ; Панов Н.М., А-17-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты и константы варианта
              =1     1  ; Параметры варианта А-17, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 17            ; номер группы
              =1     5  Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 4000h        ; клавиатура: запись столбцов / чтение строк, CS Y2
              =1    10  ADR_Y2       EQU 2000h        ; регистр Y2, CS Y1
              =1    11  BUF_START    EQU 0C000h        ; первая ячейка буфера, CS Y6
              =1    12  BUF_END      EQU 0C71Ah        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1818
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 4Bh          ; «голова», младший байт
              =1    22  HEAD_H       EQU 4Ch          ; «голова», старший байт
              =1    23  TAIL_L       EQU 4Dh          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Eh          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    26  F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2347 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0D5h
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 307           ; T1 = 307 мс
              =1    39  T3_TICKS     EQU 2685          ; T3 = 2685 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; отдельных переменных нет: указатели хранятся в ОЗУ по именам из vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек ниже банков 1–3
002E D2B4           26          setb PIN_CSEN           ; дешифратор CS включён
0030 754B00         27          mov HEAD_L, #LOW(BUF_START)     ; голова — начало буфера
0033 754CC0         28          mov HEAD_H, #HIGH(BUF_START)
0036 754D00         29          mov TAIL_L, #LOW(BUF_START)     ; хвост — тоже начало
0039 754EC0         30          mov TAIL_H, #HIGH(BUF_START)
003C D20B           31          setb F_EMPTY            ; буфер пуст
003E C21C           32          clr F_OVF               ; переполнения ещё не было
0040 7455           33          mov A, #55h             ; пример отсчёта X2
0042 120047         34          call BufWrite ; %proc%
0045 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufWrite — запись отсчёта в кольцевой буфер.
                    38  ; Вход: A — отсчёт. Выход: F_EMPTY = 0; F_OVF = 1, если запись затёрла самый старый
                    39  ; отсчёт (буфер был полон). Портит: A, DPTR, PSW; R2 сохраняется в стеке.
0047                40  BufWrite:
0047 C0D0           41          push PSW                ; сохраняем флаги вызывающего
0049 C082           42          push DPL                ; и его DPTR
004B C083           43          push DPH
004D C002           44          push AR2                ; R2 используем как временный буфер
004F FA             45          mov R2, A               ; сохраняем отсчёт на время проверки полноты
0050 200B1B         46          jb F_EMPTY, BwStore     ; пустой буфер — место точно есть
0053 E54B           47          mov A, HEAD_L           ; сравниваем младшие байты указателей
0055 B54D16         48          cjne A, TAIL_L, BwStore
0058 E54C           49          mov A, HEAD_H           ; затем старшие
005A B54E11         50          cjne A, TAIL_H, BwStore
                    51          ; голова догнала хвост при непустом буфере — буфер полон:
                    52          ; выбрасываем самый старый отсчёт, сдвигая хвост
005D 854D82         53          mov DPL, TAIL_L         ; DPTR = текущий хвост
0060 854E83         54          mov DPH, TAIL_H
0063 12008A         55          call BufNext            ; хвост на следующий отсчёт
0066 85824D         56          mov TAIL_L, DPL         ; сохраняем новый хвост
0069 85834E         57          mov TAIL_H, DPH
006C D21C           58          setb F_OVF              ; старый отсчёт потерян — переполнение
006E                59  BwStore:
006E 854B82         60          mov DPL, HEAD_L         ; DPTR = текущая голова
0071 854C83         61          mov DPH, HEAD_H
0074 EA             62          mov A, R2               ; восстанавливаем записываемый отсчёт
0075 F0             63          movx @DPTR, A           ; запись отсчёта в ячейку «головы»
0076 12008A         64          call BufNext            ; голова на следующую ячейку
0079 85824B         65          mov HEAD_L, DPL         ; сохраняем новую голову
007C 85834C         66          mov HEAD_H, DPH
007F C20B           67          clr F_EMPTY             ; после записи буфер не пуст
0081 D002           68          pop AR2                 ; восстанавливаем регистры вызывающего
0083 D083           69          pop DPH
0085 D082           70          pop DPL
0087 D0D0           71          pop PSW
0089 22             72          ret
                    73  
                    74  ; BufNext — переводит DPTR на следующую ячейку буфера.
                    75  ; После BUF_END−1 идёт BUF_START (сравниваются оба байта адреса).
                    76  ; Вход/выход: DPTR. Портит: A.
008A                77  BufNext:
008A A3             78          inc DPTR                ; следующая ячейка
008B E582           79          mov A, DPL              ; младший байт равен границе?
008D B41A08         80          cjne A, #LOW(BUF_END), BnDone
0090 E583           81          mov A, DPH              ; проверяем старший байт
0092 B4C703         82          cjne A, #HIGH(BUF_END), BnDone
0095 90C000         83          mov DPTR, #BUF_START    ; заворот в начало буфера
0098                84  BnDone:
0098 22             85          ret
                    86  END
                    87  
