; Параметры варианта А-17, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.

VAR_M        EQU 11            ; номер варианта
VAR_G        EQU 17            ; номер группы
Y2_CONST     EQU 28            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256

; --- адреса внешних устройств (movx) ---
ADR_IND      EQU 0E000h        ; индикатор, CS Y7
ADR_KB       EQU 4000h        ; клавиатура: запись столбцов / чтение строк, CS Y2
ADR_Y2       EQU 2000h        ; регистр Y2, CS Y1
BUF_START    EQU 0C000h        ; первая ячейка буфера, CS Y6
BUF_END      EQU 0C71Ah        ; первая ячейка ЗА буфером (точка заворота)
BUF_SIZE     EQU 1818

; --- клавиатура 3x4 и индикатор ---
KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)

; --- внутреннее ОЗУ ---
HEAD_L       EQU 4Bh          ; «голова», младший байт
HEAD_H       EQU 4Ch          ; «голова», старший байт
TAIL_L       EQU 4Dh          ; «хвост», младший байт
TAIL_H       EQU 4Eh          ; «хвост», старший байт
F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
F_OVF        BIT 1Ch          ; флаг переполнения буфера (23h.4)

; --- выводы ---
PIN_Y1       BIT P1.4         ; строб Y1, активный 0
PIN_Y2       BIT P1.5         ; строб Y2, активный 0
PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)

; --- таймеры (кварц 12 МГц) ---
T2_RELOAD_H  EQU 0F6h          ; строб Y2 2347 мкс, Timer1
T2_RELOAD_L  EQU 0D5h
TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
TICK_L       EQU 18h
Y1_TICKS     EQU 307           ; T1 = 307 мс
T3_TICKS     EQU 2685          ; T3 = 2685 мс
