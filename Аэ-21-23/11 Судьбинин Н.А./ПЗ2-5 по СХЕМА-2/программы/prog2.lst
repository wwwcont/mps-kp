                     1  ; Судьбинин Н.А., Аэ-21-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта Аэ-21, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 21            ; номер группы
              =1     5  Y2_CONST     EQU 32            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 2000h        ; индикатор, CS Y1
              =1     9  ADR_KB       EQU 6000h        ; клавиатура: запись столбцов / чтение строк, CS Y3
              =1    10  ADR_Y2       EQU 4000h        ; регистр Y2, CS Y2
              =1    11  BUF_START    EQU 0E000h        ; первая ячейка буфера, CS Y7
              =1    12  BUF_END      EQU 0E776h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1910
              =1    14  BUF_X2IN     EQU 0FFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 51h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 52h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 53h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 54h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    27  F_OVF        BIT 20h          ; флаг переполнения буфера (24h.0)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F9h          ; строб Y2 1751 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 29h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 313           ; T1 = 313 мс
              =1    40  T3_TICKS     EQU 2745          ; T3 = 2745 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; отдельных переменных нет: «голова», «хвост» и флаги — по адресам из vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек сразу над банком 0
002E D2B4           26          setb PIN_CSEN           ; разрешаем дешифратор адреса — без него буфер не выбирается
0030 755100         27          mov HEAD_L, #LOW(BUF_START)   ; «голова» — на первую ячейку буфера
0033 7552E0         28          mov HEAD_H, #HIGH(BUF_START)
0036 755300         29          mov TAIL_L, #LOW(BUF_START)   ; «хвост» — туда же: буфер пуст
0039 7554E0         30          mov TAIL_H, #HIGH(BUF_START)
003C D20B           31          setb F_EMPTY            ; отсчётов нет
003E C220           32          clr F_OVF               ; и ничего не терялось
0040 7455           33          mov A, #55h             ; пример отсчёта
0042 120047         34          call BufWrite ; %proc%
0045 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufWrite — запись отсчёта в кольцевой буфер IDT7005.
                    38  ; Буфер полон, когда «голова» догнала «хвост» и он не пуст (политика V: занято все BUF_SIZE ячеек);
                    39  ; тогда самый старый отсчёт выбрасывается — «хвост» сдвигается вперёд, ставится F_OVF.
                    40  ; Вход: A — отсчёт. Выход: отсчёт в ячейке бывшей «головы», «голова» на следующей ячейке,
                    41  ; F_EMPTY = 0; F_OVF = 1, если затёрт самый старый отсчёт (иначе F_OVF не меняется).
                    42  ; Портит A, B, DPTR, PSW.
0047                43  BufWrite:
0047 F5F0           44          mov B, A                ; отсчёт придержим в B, A нужен для сравнений
0049 200B1B         45          jb F_EMPTY, BwPut       ; пустой буфер точно не полон
004C E551           46          mov A, HEAD_L
004E B55316         47          cjne A, TAIL_L, BwPut   ; «голова» не на «хвосте» — место есть
0051 E552           48          mov A, HEAD_H
0053 B55411         49          cjne A, TAIL_H, BwPut
0056 855382         50          mov DPL, TAIL_L         ; буфер полон: выбрасываем самый старый отсчёт
0059 855483         51          mov DPH, TAIL_H
005C 12007C         52          call BufNext            ; «хвост» на следующую ячейку
005F 858253         53          mov TAIL_L, DPL
0062 858354         54          mov TAIL_H, DPH
0065 D220           55          setb F_OVF              ; отмечаем, что отсчёт потерян
0067                56  BwPut:
0067 855182         57          mov DPL, HEAD_L         ; адрес ячейки, куда пишем
006A 855283         58          mov DPH, HEAD_H
006D E5F0           59          mov A, B
006F F0             60          movx @DPTR, A           ; кладём отсчёт в буфер
0070 12007C         61          call BufNext            ; «голова» на следующую ячейку
0073 858251         62          mov HEAD_L, DPL
0076 858352         63          mov HEAD_H, DPH
0079 C20B           64          clr F_EMPTY             ; теперь в буфере точно есть отсчёт
007B 22             65          ret
                    66  
                    67  ; BufNext — следующая ячейка кольцевого буфера.
                    68  ; Вход: DPTR — адрес ячейки буфера. Выход: DPTR — адрес следующей; за последней ячейкой (BUF_END − 1)
                    69  ; идёт первая (BUF_START). Портит A, PSW.
007C                70  BufNext:
007C A3             71          inc DPTR
007D E582           72          mov A, DPL
007F B47608         73          cjne A, #LOW(BUF_END), BnRet  ; младший байт не на границе — заворота нет
0082 E583           74          mov A, DPH
0084 B4E703         75          cjne A, #HIGH(BUF_END), BnRet ; старший тоже должен совпасть
0087 90E000         76          mov DPTR, #BUF_START    ; вышли за буфер — заворачиваем на начало
008A                77  BnRet:
008A 22             78          ret
                    79  END
                    80  
