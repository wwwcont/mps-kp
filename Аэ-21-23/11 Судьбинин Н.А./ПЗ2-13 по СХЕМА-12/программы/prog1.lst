                     1  ; Судьбинин Н.А., Аэ-21-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта Аэ-21, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 21            ; номер группы
              =1     5  Y2_CONST     EQU 32            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 2000h        ; индикатор, CS Y1
              =1     9  ADR_KB       EQU 6000h        ; клавиатура: запись столбцов / чтение строк, CS Y3
              =1    10  ADR_Y2       EQU 4000h        ; регистр Y2, CS Y2
              =1    11  BUF_START    EQU 0E000h        ; первая ячейка буфера, CS Y7
              =1    12  BUF_END      EQU 0E776h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1910
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 51h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 52h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 53h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 54h          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    26  F_OVF        BIT 20h          ; флаг переполнения буфера (24h.0)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F9h          ; строб Y2 1751 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 29h
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 313           ; T1 = 313 мс
              =1    39  T3_TICKS     EQU 2745          ; T3 = 2745 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; переменных в ОЗУ нет: всё держится в регистрах банка 0 и в стеке
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003D          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек сразу над банком 0
002E D2B4           26          setb PIN_CSEN           ; разрешаем дешифратор адреса, иначе клавиатура не выбирается
0030 906000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; опускаем все столбцы: любое нажатие замкнёт строку на 0 и даст INT0
0035 D288           30          setb IT0                ; INT0 ловим по спаду — одно нажатие = один вызов
0037 D2A8           31          setb EX0                ; разрешаем прерывание от клавиатуры
0039 D2AF           32          setb EA                 ; и прерывания вообще
003B 80FE           33          jmp $ ; %stop%
                    34  
                    35  ; KbScan — опрос матрицы клавиатуры 3x4 (вызывается из обработчика INT0).
                    36  ; Столбцы опускаются в 0 по одному, по прочитанным строкам ищется единственная нажатая клавиша.
                    37  ; Вход: нет. Выход: A — код клавиши по табл. 3 ТЗ (0…9, «Т» = 10, «С» = 11) или 0FFh,
                    38  ; если не нажато ничего либо нажато две клавиши и больше. После опроса все столбцы снова в 0.
                    39  ; Портит только A: PSW, DPTR, B, R2–R5 сохраняются в стеке.
003D                40  KbScan:
003D C0D0           41          push PSW
003F C0F0           42          push B
0041 C082           43          push DPL
0043 C083           44          push DPH
0045 C002           45          push AR2
0047 C003           46          push AR3
0049 C004           47          push AR4
004B C005           48          push AR5
004D 906000         49          mov DPTR, #ADR_KB
0050 7CFF           50          mov R4, #0FFh           ; R4 — найденный код; 0FFh — пока ничего не нашли
0052 7A00           51          mov R2, #0              ; R2 — номер текущего столбца (0 = Col1)
0054 7BFE           52          mov R3, #11111110b      ; R3 — что пишем в столбцы: 0 только у опрашиваемого
0056                53  KsCol:
0056 EB             54          mov A, R3
0057 F0             55          movx @DPTR, A           ; опускаем один столбец, остальные держим в 1
0058 E0             56          movx A, @DPTR           ; читаем, какие строки он притянул к 0
0059 540F           57          anl A, #(1 SHL KB_ROWS) - 1   ; оставляем только подключённые строки Row1…Row4
005B 640F           58          xrl A, #(1 SHL KB_ROWS) - 1   ; переворачиваем: теперь 1 = клавиша на этой строке нажата
005D 6022           59          jz KsNext               ; в этом столбце ничего — к следующему
005F BCFF29         60          cjne R4, #0FFh, KsBad   ; клавиша уже была в другом столбце — нажато две
0062 F5F0           61          mov B, A
0064 14             62          dec A
0065 55F0           63          anl A, B                ; x AND (x-1) = 0 только если нажата ровно одна строка
0067 7022           64          jnz KsBad               ; две строки в одном столбце — ошибка
0069 E5F0           65          mov A, B
006B 7D00           66          mov R5, #0              ; R5 — номер строки, ищем единственную единицу
006D                67  KsRow:
006D 13             68          rrc A                   ; выталкиваем младшую строку в перенос
006E 4003           69          jc KsHit                ; нашли нажатую строку
0070 0D             70          inc R5
0071 80FA           71          sjmp KsRow
0073                72  KsHit:
0073 ED             73          mov A, R5
0074 75F003         74          mov B, #KB_COLS
0077 A4             75          mul AB                  ; позиция клавиши в таблице = строка * 3 + столбец
0078 2A             76          add A, R2
0079 9000A7         77          mov DPTR, #KbCodes
007C 93             78          movc A, @A+DPTR         ; берём код клавиши по раскладке рис. 4 ТЗ
007D FC             79          mov R4, A               ; запоминаем, но опрос продолжаем — вдруг нажата ещё одна
007E 906000         80          mov DPTR, #ADR_KB       ; возвращаем адрес клавиатуры
0081                81  KsNext:
0081 EB             82          mov A, R3
0082 23             83          rl A                    ; ноль переезжает на следующий столбец
0083 FB             84          mov R3, A
0084 0A             85          inc R2
0085 BA03CE         86          cjne R2, #KB_COLS, KsCol      ; пока не прошли все три столбца
0088 EC             87          mov A, R4               ; итог: код единственной клавиши или 0FFh (ничего не нажато)
0089 8002           88          sjmp KsEnd
008B                89  KsBad:
008B 74FF           90          mov A, #0FFh            ; нажато больше одной клавиши
008D                91  KsEnd:
008D FC             92          mov R4, A               ; придерживаем результат
008E 906000         93          mov DPTR, #ADR_KB
0091 E4             94          clr A
0092 F0             95          movx @DPTR, A           ; все столбцы обратно в 0 — следующее нажатие снова даст INT0
0093 C289           96          clr IE0                 ; пока перебирали столбцы, линия INT0 дёргалась — гасим ложный запрос
0095 EC             97          mov A, R4
0096 D005           98          pop AR5
0098 D004           99          pop AR4
009A D003          100          pop AR3
009C D002          101          pop AR2
009E D083          102          pop DPH
00A0 D082          103          pop DPL
00A2 D0F0          104          pop B
00A4 D0D0          105          pop PSW
00A6 22            106          ret
                   107  
                   108  ; Коды клавиш по строкам (Row1…Row4), в строке — Col1…Col3 (рис. 4 ТЗ, раскладка 3x4)
00A7               109  KbCodes:
00A7 010203        110          DB 1, 2, 3
00AA 040506        111          DB 4, 5, 6
00AD 070809        112          DB 7, 8, 9
00B0 000A0B        113          DB 0, 10, 11            ; «0», «Т», «С»
                   114  END
                   115  
