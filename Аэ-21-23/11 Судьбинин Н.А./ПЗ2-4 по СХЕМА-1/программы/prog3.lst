                     1  ; Судьбинин Н.А., Аэ-21-23, 11, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта Аэ-21, M=11 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 11            ; номер варианта
              =1     4  VAR_G        EQU 21            ; номер группы
              =1     5  Y2_CONST     EQU 32            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 2000h        ; индикатор, CS Y1
              =1     9  ADR_KB       EQU 6000h        ; клавиатура: запись столбцов / чтение строк, CS Y3
              =1    10  ADR_Y2       EQU 4000h        ; регистр Y2, CS Y2
              =1    11  BUF_START    EQU 0E000h        ; первая ячейка буфера, CS Y7
              =1    12  BUF_END      EQU 0E776h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1910
              =1    14  BUF_X2IN     EQU 0FFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 51h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 52h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 53h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 54h          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 0Bh          ; флаг пустоты буфера (21h.3)
              =1    27  F_OVF        BIT 20h          ; флаг переполнения буфера (24h.0)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F9h          ; строб Y2 1751 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 29h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 313           ; T1 = 313 мс
              =1    40  T3_TICKS     EQU 2745          ; T3 = 2745 мс
              =1    41  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 досчитал T2 — строб Y2 закончен
001B D295           18          setb PIN_Y2             ; первым делом снимаем строб, чтобы он не затянулся
001D C28E           19          clr TR1                 ; таймер больше не нужен до следующего вывода Y2
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h            ; стек сразу над банком 0
002E D2B4           28          setb PIN_CSEN           ; разрешаем дешифратор адреса — без него регистр Y2 не выбирается
0030 D295           29          setb PIN_Y2             ; строб Y2 в пассивной единице
0032 758910         30          mov TMOD, #10h          ; Timer1 — 16-битный счётчик (режим 1), Timer0 не используется
0035 D2AB           31          setb ET1                ; переполнение Timer1 заканчивает строб
0037 D2AF           32          setb EA
0039 753003         33          mov X1, #3              ; пример входных данных
003C 7531C8         34          mov X2, #200
003F 120044         35          call Y2Out ; %proc%
0042 80FE           36          jmp $ ; %stop%
                    37  
                    38  ; Y2Out — расчёт Y2 = (G + M + X1 + X2) mod 256, при X1 = 0 выдаётся Y2 = 0;
                    39  ; значение пишется в регистр Y2, затем запускается строб PIN_Y2 = 0 длительностью T2.
                    40  ; Процедура не ждёт конца строба: его снимает обработчик Timer1.
                    41  ; Вход: X1, X2 (внутреннее ОЗУ). Выход: регистр Y2, PIN_Y2 = 0, Timer1 запущен на T2.
                    42  ; Портит A, DPTR, PSW.
0044                43  Y2Out:
0044 E530           44          mov A, X1
0046 6004           45          jz Y2Put                ; X1 = 0 — выход пассивный, выводим ноль
0048 2531           46          add A, X2
004A 2420           47          add A, #Y2_CONST        ; + (G + M); перенос за 8 бит отбрасывается — это и есть mod 256
004C                48  Y2Put:
004C 904000         49          mov DPTR, #ADR_Y2
004F F0             50          movx @DPTR, A           ; сначала значение в регистр — к началу строба оно уже на выходе
0050 C28E           51          clr TR1                 ; на случай, если прошлый строб ещё идёт — перезапускаем отсчёт
0052 758DF9         52          mov TH1, #T2_RELOAD_H   ; загрузка на всю длительность T2
0055 758B29         53          mov TL1, #T2_RELOAD_L
0058 C28F           54          clr TF1                 ; убираем старый флаг переполнения, чтобы не было ложного конца
005A C295           55          clr PIN_Y2              ; начало строба
005C D28E           56          setb TR1                ; и сразу пускаем отсчёт T2
005E 22             57          ret
                    58  END
                    59  
