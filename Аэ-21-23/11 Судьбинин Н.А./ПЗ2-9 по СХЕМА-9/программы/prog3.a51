; Судьбинин Н.А., Аэ-21-23, 11, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
X2:     DS 1                    ; отсчёт из буфера
CSEG AT 0h
        sjmp START
org 03h ; "заглушка" для INT0
        nop
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh                         ; Timer1 досчитал T2 — строб Y2 закончен
        setb PIN_Y2             ; первым делом снимаем строб, чтобы он не затянулся
        clr TR1                 ; таймер больше не нужен до следующего вывода Y2
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h            ; стек сразу над банком 0
        setb PIN_CSEN           ; разрешаем дешифратор адреса — без него регистр Y2 не выбирается
        setb PIN_Y2             ; строб Y2 в пассивной единице
        mov TMOD, #10h          ; Timer1 — 16-битный счётчик (режим 1), Timer0 не используется
        setb ET1                ; переполнение Timer1 заканчивает строб
        setb EA
        mov X1, #3              ; пример входных данных
        mov X2, #200
        call Y2Out ; %proc%
        jmp $ ; %stop%

; Y2Out — расчёт Y2 = (G + M + X1 + X2) mod 256, при X1 = 0 выдаётся Y2 = 0;
; значение пишется в регистр Y2, затем запускается строб PIN_Y2 = 0 длительностью T2.
; Процедура не ждёт конца строба: его снимает обработчик Timer1.
; Вход: X1, X2 (внутреннее ОЗУ). Выход: регистр Y2, PIN_Y2 = 0, Timer1 запущен на T2.
; Портит A, DPTR, PSW.
Y2Out:
        mov A, X1
        jz Y2Put                ; X1 = 0 — выход пассивный, выводим ноль
        add A, X2
        add A, #Y2_CONST        ; + (G + M); перенос за 8 бит отбрасывается — это и есть mod 256
Y2Put:
        mov DPTR, #ADR_Y2
        movx @DPTR, A           ; сначала значение в регистр — к началу строба оно уже на выходе
        clr TR1                 ; на случай, если прошлый строб ещё идёт — перезапускаем отсчёт
        mov TH1, #T2_RELOAD_H   ; загрузка на всю длительность T2
        mov TL1, #T2_RELOAD_L
        clr TF1                 ; убираем старый флаг переполнения, чтобы не было ложного конца
        clr PIN_Y2              ; начало строба
        setb TR1                ; и сразу пускаем отсчёт T2
        ret
END
