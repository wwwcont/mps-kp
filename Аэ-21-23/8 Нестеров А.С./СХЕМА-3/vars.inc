; Параметры варианта Аэ-21, M=8 (ТЗ 2026). Сгенерировано mpsgen — не править руками.

VAR_M        EQU 8            ; номер варианта
VAR_G        EQU 21            ; номер группы
Y2_CONST     EQU 29            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256

; --- адреса внешних устройств (movx) ---
ADR_IND      EQU 4000h        ; индикатор, CS Y2
ADR_KB       EQU 6000h        ; клавиатура: запись столбцов / чтение строк, CS Y3
ADR_Y2       EQU 2000h        ; регистр Y2, CS Y1
BUF_START    EQU 0E000h        ; первая ячейка буфера, CS Y7
BUF_END      EQU 0E758h        ; первая ячейка ЗА буфером (точка заворота)
BUF_SIZE     EQU 1880
ADR_HEADL    EQU 0h        ; регистр адреса правого порта A0R–A7R (младший байт «головы»), CS Y0
ADR_HEADH    EQU 8000h        ; регистр адреса правого порта A8R–A12R (старший байт «головы» & 1Fh: A13–A15 — окно, их задаёт CS), CS Y4

; --- клавиатура 4x3 и индикатор ---
KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)

; --- внутреннее ОЗУ ---
HEAD_L       EQU 51h          ; «голова», младший байт
HEAD_H       EQU 52h          ; «голова», старший байт
TAIL_L       EQU 53h          ; «хвост», младший байт
TAIL_H       EQU 54h          ; «хвост», старший байт
F_EMPTY      BIT 8h          ; флаг пустоты буфера (21h.0)
F_OVF        BIT 1Dh          ; флаг переполнения буфера (23h.5)

; --- выводы ---
PIN_Y1       BIT P1.1         ; строб Y1, активный 0
PIN_Y2       BIT P1.2         ; строб Y2, активный 0
PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)

; --- таймеры (кварц 12 МГц) ---
T2_RELOAD_H  EQU 0F9h          ; строб Y2 1661 мкс, Timer1
T2_RELOAD_L  EQU 83h
TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
TICK_L       EQU 18h
Y1_TICKS     EQU 283           ; T1 = 283 мс
T3_TICKS     EQU 2595          ; T3 = 2595 мс
