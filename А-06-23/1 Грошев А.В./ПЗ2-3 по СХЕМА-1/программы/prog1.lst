                     1  ; Грошев А.В., А-06-23, 1, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-06, M=1 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 1            ; номер варианта
              =1     4  VAR_G        EQU 6            ; номер группы
              =1     5  Y2_CONST     EQU 7            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 4000h        ; индикатор, CS Y2
              =1     9  ADR_KB       EQU 8000h        ; клавиатура: запись столбцов / чтение строк, CS Y4
              =1    10  ADR_Y2       EQU 6000h        ; регистр Y2, CS Y3
              =1    11  BUF_START    EQU 2000h        ; первая ячейка буфера, CS Y1
              =1    12  BUF_END      EQU 24BAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1210
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 38h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 39h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 3Ah          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 3Bh          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 1h          ; флаг пустоты буфера (20h.1)
              =1    26  F_OVF        BIT 7h          ; флаг переполнения буфера (20h.7)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0FAh          ; строб Y2 1536 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0h
              =1    36  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 30h
              =1    38  Y1_TICKS     EQU 88           ; T1 = 176 мс
              =1    39  T3_TICKS     EQU 1075          ; T3 = 2150 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; переменные в ОЗУ не нужны: всё держится в регистрах банка 0
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; разрешаем дешифратор адреса, иначе клавиатура не выбирается
0030 908000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; опускаем все столбцы: любое нажатие сразу потянет INT0 вниз
0035 D288           30          setb IT0                ; INT0 срабатывает по спаду
0037 C289           31          clr IE0                 ; забываем возможный ложный запрос до разрешения
0039 D2A8           32          setb EX0                ; разрешаем прерывание от клавиатуры
003B D2AF           33          setb EA                 ; и прерывания вообще
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос матрицы 3x4 по столбцам (вызывается из обработчика INT0).
                    37  ; Назначение: найти единственную нажатую клавишу и вернуть её код по табл. 3 ТЗ.
                    38  ; Вход: нет.
                    39  ; Выход: A — код клавиши (0…9, «Т» = 10, «С» = 11) или 0FFh, если нажато
                    40  ;        больше одной клавиши или ни одной (помеха).
                    41  ; Портит: только A; B, DPTR, PSW, R2–R7 сохраняются в стеке.
003F                42  KbScan:
003F C0F0           43          push B
0041 C0D0           44          push PSW
0043 C082           45          push DPL
0045 C083           46          push DPH
0047 C002           47          push AR2
0049 C003           48          push AR3
004B C004           49          push AR4
004D C005           50          push AR5
004F C006           51          push AR6
0051 C007           52          push AR7
0053 908000         53          mov DPTR, #ADR_KB
0056 7A00           54          mov R2, #0              ; R2 — сколько замкнутых контактов нашли
0058 7B00           55          mov R3, #0              ; R3 — номер текущего столбца с нуля
005A 7CFE           56          mov R4, #0FEh           ; R4 — маска столбцов: ноль только у опрашиваемого
005C                57  KsCol:
005C EC             58          mov A, R4
005D F0             59          movx @DPTR, A           ; опускаем один столбец, остальные держим в 1
005E E0             60          movx A, @DPTR           ; снимаем состояние строк
005F 540F           61          anl A, #(1 SHL KB_ROWS) - 1   ; оставляем только подключённые строки
0061 640F           62          xrl A, #(1 SHL KB_ROWS) - 1   ; теперь 1 — строка замкнута на этот столбец
0063 FD             63          mov R5, A               ; R5 — ещё не разобранные замкнутые строки
0064 EB             64          mov A, R3
0065 FE             65          mov R6, A               ; R6 — индекс клавиши в таблице: строка*KB_COLS + столбец
0066                66  KsRow:
0066 ED             67          mov A, R5
0067 600E           68          jz KsNext               ; замкнутых строк в этом столбце больше нет
0069 C3             69          clr C
006A 13             70          rrc A                   ; младшая строка уходит в перенос
006B FD             71          mov R5, A
006C 5003           72          jnc KsSkip              ; эта строка не замкнута
006E 0A             73          inc R2                  ; ещё одно нажатие
006F EE             74          mov A, R6
0070 FF             75          mov R7, A               ; запоминаем индекс найденной клавиши
0071                76  KsSkip:
0071 EE             77          mov A, R6
0072 2403           78          add A, #KB_COLS         ; переходим к той же колонке строкой ниже
0074 FE             79          mov R6, A
0075 80EF           80          sjmp KsRow
0077                81  KsNext:
0077 EC             82          mov A, R4
0078 23             83          rl A                    ; ноль маски сдвигается на следующий столбец
0079 FC             84          mov R4, A
007A 0B             85          inc R3
007B BB03DE         86          cjne R3, #KB_COLS, KsCol
007E E4             87          clr A
007F F0             88          movx @DPTR, A           ; снова все столбцы в 0 — ждём следующего нажатия
0080 C289           89          clr IE0                 ; во время опроса линия INT0 дёргалась — лишний запрос не нужен
0082 BA0107         90          cjne R2, #1, KsBad      ; принимаем только одну нажатую клавишу
0085 EF             91          mov A, R7
0086 9000A3         92          mov DPTR, #KeyTab
0089 93             93          movc A, @A+DPTR         ; индекс в матрице -> код клавиши
008A 8002           94          sjmp KsOut
008C                95  KsBad:
008C 74FF           96          mov A, #0FFh            ; ничего не нажато или нажато несколько
008E                97  KsOut:
008E D007           98          pop AR7
0090 D006           99          pop AR6
0092 D005          100          pop AR5
0094 D004          101          pop AR4
0096 D003          102          pop AR3
0098 D002          103          pop AR2
009A D083          104          pop DPH
009C D082          105          pop DPL
009E D0D0          106          pop PSW
00A0 D0F0          107          pop B
00A2 22            108          ret
                   109  
                   110  ; Коды клавиш по рис. 4 ТЗ (3x4): строки сверху вниз, в строке столбцы слева направо
00A3               111  KeyTab:
00A3 010203        112          DB 1, 2, 3
00A6 040506        113          DB 4, 5, 6
00A9 070809        114          DB 7, 8, 9
00AC 000A0B        115          DB 0, 10, 11
                   116  END
                   117  
