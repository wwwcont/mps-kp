                     1  ; Грошев А.В., А-06-23, 1, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-06, M=1 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 1            ; номер варианта
              =1     4  VAR_G        EQU 6            ; номер группы
              =1     5  Y2_CONST     EQU 7            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 4000h        ; индикатор, CS Y2
              =1     9  ADR_KB       EQU 8000h        ; клавиатура: запись столбцов / чтение строк, CS Y4
              =1    10  ADR_Y2       EQU 6000h        ; регистр Y2, CS Y3
              =1    11  BUF_START    EQU 2000h        ; первая ячейка буфера, CS Y1
              =1    12  BUF_END      EQU 24BAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1210
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 38h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 39h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 3Ah          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 3Bh          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 1h          ; флаг пустоты буфера (20h.1)
              =1    26  F_OVF        BIT 7h          ; флаг переполнения буфера (20h.7)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0FAh          ; строб Y2 1536 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 0h
              =1    36  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 30h
              =1    38  Y1_TICKS     EQU 88           ; T1 = 176 мс
              =1    39  T3_TICKS     EQU 1075          ; T3 = 2150 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; переменные не нужны: «голова», «хвост» и флаги уже заданы в vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор включён — буфер доступен по movx
0030 753800         27          mov HEAD_L, #LOW(BUF_START)   ; буфер пуст: «голова» и «хвост» на первой ячейке
0033 753920         28          mov HEAD_H, #HIGH(BUF_START)
0036 753A00         29          mov TAIL_L, #LOW(BUF_START)
0039 753B20         30          mov TAIL_H, #HIGH(BUF_START)
003C D201           31          setb F_EMPTY            ; данных нет
003E C207           32          clr F_OVF               ; и ничего не терялось
0040 7455           33          mov A, #55h             ; пробный отсчёт для записи
0042 120047         34          call BufWrite ; %proc%
0045 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufWrite — запись отсчёта в кольцевой буфер IDT7005.
                    38  ; Назначение: положить байт в ячейку «головы» и сдвинуть «голову»; если буфер
                    39  ;   полон (голова догнала хвост, буфер не пуст), самый старый отсчёт теряется:
                    40  ;   «хвост» сдвигается вперёд и ставится флаг переполнения.
                    41  ; Вход: A — отсчёт; HEAD, TAIL, F_EMPTY — текущее состояние буфера.
                    42  ; Выход: HEAD (и при переполнении TAIL) сдвинуты; F_EMPTY = 0; F_OVF = 1 при потере.
                    43  ; Портит: ничего (A, B, DPTR, PSW сохраняются).
0047                44  BufWrite:
0047 C0E0           45          push ACC
0049 C0F0           46          push B
004B C0D0           47          push PSW
004D C082           48          push DPL
004F C083           49          push DPH
0051 F5F0           50          mov B, A                ; отсчёт держим в B, A нужен для сравнений
0053 20011B         51          jb F_EMPTY, BwPut       ; пустой буфер полным быть не может
0056 E538           52          mov A, HEAD_L
0058 B53A16         53          cjne A, TAIL_L, BwPut   ; голова не на хвосте — место есть
005B E539           54          mov A, HEAD_H
005D B53B11         55          cjne A, TAIL_H, BwPut
0060 853A82         56          mov DPL, TAIL_L         ; места нет: выбрасываем самый старый отсчёт
0063 853B83         57          mov DPH, TAIL_H
0066 120090         58          call NextCell
0069 85823A         59          mov TAIL_L, DPL
006C 85833B         60          mov TAIL_H, DPH
006F D207           61          setb F_OVF              ; отмечаем, что данные терялись
0071                62  BwPut:
0071 853882         63          mov DPL, HEAD_L
0074 853983         64          mov DPH, HEAD_H
0077 E5F0           65          mov A, B
0079 F0             66          movx @DPTR, A           ; кладём отсчёт в ячейку «головы»
007A 120090         67          call NextCell
007D 858238         68          mov HEAD_L, DPL         ; «голова» смотрит на следующую свободную ячейку
0080 858339         69          mov HEAD_H, DPH
0083 C201           70          clr F_EMPTY             ; в буфере есть хотя бы один отсчёт
0085 D083           71          pop DPH
0087 D082           72          pop DPL
0089 D0D0           73          pop PSW
008B D0F0           74          pop B
008D D0E0           75          pop ACC
008F 22             76          ret
                    77  
                    78  ; NextCell — следующая ячейка кольцевого буфера.
                    79  ; Вход: DPTR — адрес ячейки внутри буфера.
                    80  ; Выход: DPTR — следующая ячейка; после последней (BUF_END - 1) — снова BUF_START.
                    81  ; Портит: A, флаги.
0090                82  NextCell:
0090 A3             83          inc DPTR
0091 E582           84          mov A, DPL
0093 B4BA08         85          cjne A, #LOW(BUF_END), NcOut  ; младший байт не совпал — до конца не дошли
0096 E583           86          mov A, DPH
0098 B42403         87          cjne A, #HIGH(BUF_END), NcOut
009B 902000         88          mov DPTR, #BUF_START    ; вышли за буфер — заворачиваем на начало
009E                89  NcOut:
009E 22             90          ret
                    91  END
                    92  
