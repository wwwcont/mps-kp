                     1  ; Грошев А.В., А-06-23, 1, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-06, M=1 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 1            ; номер варианта
              =1     4  VAR_G        EQU 6            ; номер группы
              =1     5  Y2_CONST     EQU 7            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 4000h        ; индикатор, CS Y2
              =1     9  ADR_KB       EQU 8000h        ; клавиатура: запись столбцов / чтение строк, CS Y4
              =1    10  ADR_Y2       EQU 6000h        ; регистр Y2, CS Y3
              =1    11  BUF_START    EQU 2000h        ; первая ячейка буфера, CS Y1
              =1    12  BUF_END      EQU 24BAh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1210
              =1    14  BUF_X2IN     EQU 3FFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 00h           ; индикатор погашен (общий катод: 1 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 38h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 39h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 3Ah          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 3Bh          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 1h          ; флаг пустоты буфера (20h.1)
              =1    27  F_OVF        BIT 7h          ; флаг переполнения буфера (20h.7)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0FAh          ; строб Y2 1536 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0h
              =1    37  TICK_H       EQU 0F8h          ; тик 2 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 30h
              =1    39  Y1_TICKS     EQU 88           ; T1 = 176 мс
              =1    40  T3_TICKS     EQU 1075          ; T3 = 2150 мс
              =1    41  
                     3  DSEG AT 30h
                     4  Y1Left: DS 1                    ; сколько тиков по 2 мс осталось до конца строба Y1
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh                         ; Timer0 — тик для отсчёта T1
000B 02005A         11          ljmp T0Isr
0013                12  org 13h ; "заглушка" для INT1
0013 00             13          nop
0014 32             14          reti
001B                15  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             16          nop
001C 32             17          reti
0023                18  org 23h ; "заглушка" для UART
0023 00             19          nop
0024 32             20          reti
002B                21  org 2bh
002B                22  START:
                    23  ; Инициализация МК **********************************************
002B 758107         24          mov SP, #07h
002E D2B4           25          setb PIN_CSEN           ; дешифратор адреса разрешён
0030 D291           26          setb PIN_Y1             ; строб Y1 в пассивном состоянии
0032 753000         27          mov Y1Left, #0
0035 5389F0         28          anl TMOD, #0F0h         ; Timer0 — 16-битный счётчик (режим 1), Timer1 не трогаем
0038 438901         29          orl TMOD, #01h
003B C28C           30          clr TR0                 ; таймер пока стоит
003D C28D           31          clr TF0
003F D2A9           32          setb ET0                ; прерывание по переполнению Timer0
0041 D2AF           33          setb EA
0043 120048         34          call Y1Start ; %proc%
0046 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; Y1Start — запуск строба Y1 длительностью T1.
                    38  ; Назначение: опустить PIN_Y1 в 0 и запустить Timer0 на Y1_TICKS тиков по 2 мс;
                    39  ;   строб поднимает обработчик Timer0, процедура сразу возвращается.
                    40  ; Вход: нет. Выход: PIN_Y1 = 0, Timer0 запущен, Y1Left = Y1_TICKS.
                    41  ; Портит: ничего (меняет только TH0, TL0, TF0, TR0).
0048                42  Y1Start:
0048 C28C           43          clr TR0                 ; повторный вызов начинает отсчёт заново
004A 758CF8         44          mov TH0, #TICK_H        ; первый тик — ровно 2 мс
004D 758A30         45          mov TL0, #TICK_L
0050 C28D           46          clr TF0
0052 753058         47          mov Y1Left, #Y1_TICKS
0055 C291           48          clr PIN_Y1              ; начало строба
0057 D28C           49          setb TR0
0059 22             50          ret
                    51  
                    52  ; T0Isr — обработчик Timer0: прошёл очередной тик 2 мс.
                    53  ; Назначение: перезарядить Timer0 с учётом тактов, натикавших после переполнения,
                    54  ;   уменьшить счётчик и по его обнулению закончить строб Y1.
                    55  ; Вход: Y1Left. Выход: Y1Left - 1; при нуле PIN_Y1 = 1 и Timer0 остановлен.
                    56  ; Портит: ничего (A и PSW в стеке).
005A                57  T0Isr:
005A C0E0           58          push ACC
005C C0D0           59          push PSW
005E C28C           60          clr TR0                 ; на время перезарядки таймер стоит (7 тактов)
0060 E58A           61          mov A, TL0
0062 2437           62          add A, #LOW((TICK_H SHL 8) + TICK_L + 7)   ; добавляем к уже натикавшему и
0064 F58A           63          mov TL0, A                                 ; учитываем 7 тактов остановки
0066 E58C           64          mov A, TH0
0068 34F8           65          addc A, #HIGH((TICK_H SHL 8) + TICK_L + 7)
006A F58C           66          mov TH0, A
006C D28C           67          setb TR0
006E D53004         68          djnz Y1Left, T0Out      ; строб ещё идёт
0071 C28C           69          clr TR0                 ; T1 истекло: таймер больше не нужен
0073 D291           70          setb PIN_Y1             ; конец строба
0075                71  T0Out:
0075 D0D0           72          pop PSW
0077 D0E0           73          pop ACC
0079 32             74          reti
                    75  END
                    76  
