                     1  ; Сапелин А.С., А-12-23, 18, v1
                     2  $INCLUDE (vars.inc)
              =1     1  ; Параметры варианта А-12, M=18 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 18            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 30            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1784
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 12h          ; флаг пустоты буфера (22h.2)
              =1    26  F_OVF        BIT 1Eh          ; флаг переполнения буфера (23h.6)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2452 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 6Ch
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 371           ; T1 = 371 мс
              =1    39  T3_TICKS     EQU 3240          ; T3 = 3240 мс
              =1    40  
                     3  DSEG AT 30h
                     4  CSEG AT 0h
0000 8029            5          sjmp START
0003                 6  org 03h
0003 00              7          nop
0004 32              8          reti
000B                 9  org 0bh
000B 00             10          nop
000C 32             11          reti
0013                12  org 13h
0013 00             13          nop
0014 32             14          reti
001B                15  org 1bh
001B 00             16          nop
001C 32             17          reti
0023                18  org 23h
0023 00             19          nop
0024 32             20          reti
002B                21  org 2bh
002B                22  START:
002B 758107         23          mov SP, #07h            ; начальный стек по шаблону ТЗ
002E 75A800         24          mov IE, #0              ; самостоятельная программа не обслуживает IRQ
0031 D2B4           25          setb PIN_CSEN           ; доступ к ОЗУ разрешается дешифратором
0033 754700         26          mov HEAD_L, #LOW BUF_START ; следующая запись начнётся с начала кольца
0036 7548A0         27          mov HEAD_H, #HIGH BUF_START
0039 754900         28          mov TAIL_L, #LOW BUF_START ; чтение и запись пока имеют общий адрес
003C 754AA0         29          mov TAIL_H, #HIGH BUF_START
003F D212           30          setb F_EMPTY            ; в памяти ещё нет действительных отсчётов
0041 C21E           31          clr F_OVF               ; исходное состояние не является переполнением
0043 120048         32          call BufRead ; %proc%
0046 80FE           33          jmp $ ; %stop%
                    34  
                    35  ; Назначение: BufRead извлекает самый старый отсчёт из кольцевого буфера.
                    36  ; Вход: HEAD, TAIL и флаги из vars.inc; данные во внешнем ОЗУ.
                    37  ; Выход: A — прочитанный байт, при пустом буфере A = 0 без изменения указателей и флагов.
                    38  ; Выход: после чтения TAIL передвинут, F_OVF = 0, F_EMPTY отражает опустошение.
                    39  ; Портит: A, DPTR, флаги PSW; B сохраняется.
0048                40  BufRead:
0048 301202         41          jnb F_EMPTY, ReadData    ; пустой буфер нельзя читать и передвигать
004B E4             42          clr A
004C 22             43          ret
004D                44  ReadData:
004D C0F0           45          push B                  ; временное хранение отсчёта не меняет B вызывающей программы
004F 854982         46          mov DPL, TAIL_L
0052 854A83         47          mov DPH, TAIL_H          ; адрес самого старого отсчёта
0055 E0             48          movx A, @DPTR
0056 F5F0           49          mov B, A                ; сохранить результат на время проверки границ
0058 A3             50          inc DPTR                ; предварительно перейти к следующему отсчёту
0059 E582           51          mov A, DPL
005B B4F808         52          cjne A, #LOW BUF_END, ReadStore
005E E583           53          mov A, DPH
0060 B4A603         54          cjne A, #HIGH BUF_END, ReadStore
0063 90A000         55          mov DPTR, #BUF_START     ; конец кольца переходит в его начало
0066                56  ReadStore:
0066 858249         57          mov TAIL_L, DPL
0069 85834A         58          mov TAIL_H, DPH          ; зафиксировать новый адрес чтения
006C C21E           59          clr F_OVF               ; прочитанный отсчёт освободил место
006E C212           60          clr F_EMPTY
0070 E582           61          mov A, DPL
0072 B54707         62          cjne A, HEAD_L, ReadDone ; разные указатели означают оставшиеся данные
0075 E583           63          mov A, DPH
0077 B54802         64          cjne A, HEAD_H, ReadDone
007A D212           65          setb F_EMPTY            ; хвост догнал голову после последнего отсчёта
007C                66  ReadDone:
007C E5F0           67          mov A, B                ; вернуть именно отсчёт, а не байт адреса
007E D0F0           68          pop B
0080 22             69          ret
                    70  END
                    71  
