                     1  ; Сапелин А.С., А-12-23, 18, v1
                     2  $INCLUDE (vars.inc)
              =1     1  ; Параметры варианта А-12, M=18 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 18            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 30            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1784
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 12h          ; флаг пустоты буфера (22h.2)
              =1    26  F_OVF        BIT 1Eh          ; флаг переполнения буфера (23h.6)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2452 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 6Ch
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 371           ; T1 = 371 мс
              =1    39  T3_TICKS     EQU 3240          ; T3 = 3240 мс
              =1    40  
                     3  DSEG AT 30h
                     4  CSEG AT 0h
0000 8029            5          sjmp START
0003                 6  org 03h
0003 120042          7          call KbScan ; %proc%
0006 32              8          reti
000B                 9  org 0bh
000B 00             10          nop
000C 32             11          reti
0013                12  org 13h
0013 00             13          nop
0014 32             14          reti
001B                15  org 1bh
001B 00             16          nop
001C 32             17          reti
0023                18  org 23h
0023 00             19          nop
0024 32             20          reti
002B                21  org 2bh
002B                22  START:
002B 758107         23          mov SP, #07h            ; стек размещается ниже переменных и битовых флагов
002E 75D000         24          mov PSW, #0             ; используется нулевой банк регистров
0031 D2B4           25          setb PIN_CSEN           ; разрешить выбор устройств внешней шины
0033 902000         26          mov DPTR, #ADR_KB
0036 E4             27          clr A
0037 F0             28          movx @DPTR, A           ; все столбцы готовы обнаружить новое нажатие
0038 D288           29          setb IT0                ; однократный запрос по спаду INT0
003A C289           30          clr IE0                 ; исключить запрос от начальной установки столбцов
003C D2A8           31          setb EX0
003E D2AF           32          setb EA
0040 80FE           33          jmp $ ; %stop%
                    34  
                    35  ; Назначение: KbScan проверяет все контакты матрицы и считает нажатые клавиши.
                    36  ; Вход: строки и столбцы клавиатуры, подключённой к ADR_KB.
                    37  ; Выход: A — код 0–11 единственной клавиши либо 0FFh при ином числе нажатий.
                    38  ; Портит: A; остальные используемые регистры сохраняются.
0042                39  KbScan:
0042 C0D0           40          push PSW
0044 C082           41          push DPL
0046 C083           42          push DPH
0048 C000           43          push AR0
004A C001           44          push AR1
004C C002           45          push AR2
004E C003           46          push AR3
0050 C004           47          push AR4
0052 C005           48          push AR5
0054 78FE           49          mov R0, #0FEh           ; бегущий ноль начинает со столбца Col1
0056 7900           50          mov R1, #0              ; индекс первого контакта столбца в таблице
0058 7A00           51          mov R2, #0              ; пока ни одна клавиша не обнаружена
005A 7BFF           52          mov R3, #0FFh
005C                53  KbColumn:
005C 902000         54          mov DPTR, #ADR_KB
005F E8             55          mov A, R0
0060 F0             56          movx @DPTR, A           ; выбрать один столбец
0061 E0             57          movx A, @DPTR
0062 F4             58          cpl A
0063 5407           59          anl A, #(1 SHL KB_ROWS)-1 ; оставить только реально подключённые строки
0065 FC             60          mov R4, A
0066 7D03           61          mov R5, #KB_ROWS
0068                62  KbRow:
0068 EC             63          mov A, R4
0069 13             64          rrc A                   ; очередная строка попадает в перенос
006A FC             65          mov R4, A
006B 5007           66          jnc KbNextRow
006D 0A             67          inc R2                  ; считаются все замкнутые контакты
006E 9000A0         68          mov DPTR, #KeyMap
0071 E9             69          mov A, R1
0072 93             70          movc A, @A+DPTR
0073 FB             71          mov R3, A
0074                72  KbNextRow:
0074 09             73          inc R1
0075 DDF1           74          djnz R5, KbRow
0077 E8             75          mov A, R0
0078 23             76          rl A
0079 F8             77          mov R0, A               ; перенести активный ноль на следующий столбец
007A B90CDF         78          cjne R1, #(KB_COLS*KB_ROWS), KbColumn
007D 902000         79          mov DPTR, #ADR_KB
0080 E4             80          clr A
0081 F0             81          movx @DPTR, A           ; вернуть все столбцы в состояние ожидания
0082 C289           82          clr IE0                 ; убрать фронты, возникшие во время сканирования
0084 EA             83          mov A, R2
0085 B40103         84          cjne A, #1, KbInvalid
0088 EB             85          mov A, R3
0089 8002           86          sjmp KbDone
008B                87  KbInvalid:
008B 74FF           88          mov A, #0FFh
008D                89  KbDone:
008D D005           90          pop AR5
008F D004           91          pop AR4
0091 D003           92          pop AR3
0093 D002           93          pop AR2
0095 D001           94          pop AR1
0097 D000           95          pop AR0
0099 D083           96          pop DPH
009B D082           97          pop DPL
009D D0D0           98          pop PSW
009F 22             99          ret
00A0               100  KeyMap:
00A0 0104070205080306090A0B00      101          db 1,4,7,2,5,8,3,6,9,10,11,0
                   102  END
                   103  
