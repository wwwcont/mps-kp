                     1  ; Сапелин А.С., А-12-23, 18, v1
                     2  $INCLUDE (vars.inc)
              =1     1  ; Параметры варианта А-12, M=18 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 18            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 30            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1784
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 12h          ; флаг пустоты буфера (22h.2)
              =1    26  F_OVF        BIT 1Eh          ; флаг переполнения буфера (23h.6)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2452 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 6Ch
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 371           ; T1 = 371 мс
              =1    39  T3_TICKS     EQU 3240          ; T3 = 3240 мс
              =1    40  
                     3  DSEG AT 30h
                     4  TicksLo: DS 1
                     5  TicksHi: DS 1
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh
000B 020088         12          ljmp T0Isr
0013                13  org 13h
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
002B 758107         24          mov SP, #07h            ; переменные 30h и выше не пересекаются со стеком
002E 75A800         25          mov IE, #0
0031 D2B4           26          setb PIN_CSEN           ; разрешить запись в регистр индикации
0033 C28C           27          clr TR0
0035 C28D           28          clr TF0                 ; удалить прежний запрос переполнения
0037 758901         29          mov TMOD, #01h          ; Timer0 считает 16-разрядные интервалы
003A 753000         30          mov TicksLo, #0
003D 753100         31          mov TicksHi, #0          ; до первого вызова отсчёт не ведётся
0040 90E000         32          mov DPTR, #ADR_IND
0043 74FF           33          mov A, #IND_OFF
0045 F0             34          movx @DPTR, A           ; при включении все сегменты погашены
0046 D2A9           35          setb ET0
0048 D2AF           36          setb EA
004A 7405           37          mov A, #5               ; демонстрационный вывод цифры 5
004C 120051         38          call Show ; %proc%
004F 80FE           39          jmp $ ; %stop%
                    40  
                    41  ; Назначение: Show выводит символ с автоматическим гашением через T3.
                    42  ; Вход: A — код 0–9 или 10 для E; остальные коды гасят индикатор.
                    43  ; Выход: символ в регистре ADR_IND, заново запущенный отсчёт T3 либо остановка.
                    44  ; Портит: A, DPTR, PSW; обновляет TicksLo, TicksHi и Timer0.
0051                45  Show:
0051 C2A9           46          clr ET0                 ; исключить IRQ со старым счётчиком во время замены символа
0053 C28C           47          clr TR0
0055 C28D           48          clr TF0                 ; повторный вызов отменяет предыдущий срок
0057 753000         49          mov TicksLo, #0
005A 753100         50          mov TicksHi, #0
005D B40B02         51          cjne A, #11, ShowRange
0060 801D           52          sjmp ShowOff
0062                53  ShowRange:
0062 501B           54          jnc ShowOff             ; код за границей таблицы означает выключение
0064 9000BF         55          mov DPTR, #Segments
0067 93             56          movc A, @A+DPTR          ; код символа преобразуется в набор сегментов
0068 64FF           57          xrl A, #IND_OFF          ; общий анод требует активного нуля
006A 90E000         58          mov DPTR, #ADR_IND
006D F0             59          movx @DPTR, A           ; регистр удержит изображение после освобождения шины
006E 7530A8         60          mov TicksLo, #LOW T3_TICKS
0071 75310C         61          mov TicksHi, #HIGH T3_TICKS ; число тиков берётся из параметров варианта
0074 758CFC         62          mov TH0, #TICK_H
0077 758A18         63          mov TL0, #TICK_L         ; первый тик начинается с полной длительности
007A D2A9           64          setb ET0
007C D28C           65          setb TR0                ; процедура возвращается, время отсчитывается в IRQ
007E 22             66          ret
007F                67  ShowOff:
007F 90E000         68          mov DPTR, #ADR_IND
0082 74FF           69          mov A, #IND_OFF
0084 F0             70          movx @DPTR, A           ; неверный код сразу выключает все сегменты
0085 D2A9           71          setb ET0
0087 22             72          ret
                    73  
                    74  ; Назначение: T0Isr отсчитывает тики и выключает индикатор в конце T3.
                    75  ; Вход: TicksLo:TicksHi и текущее состояние Timer0.
                    76  ; Выход: счётчик уменьшен; при нуле Timer0 остановлен и индикатор погашен.
                    77  ; Портит: Timer0 и счётчик; A, PSW и DPTR восстанавливаются перед RETI.
0088                78  T0Isr:
0088 C0E0           79          push ACC                ; обработчик может прервать работу с любым символом
008A C0D0           80          push PSW
008C C082           81          push DPL
008E C083           82          push DPH                ; сохранить адрес устройства, использованный основной программой
0090 C28C           83          clr TR0
0092 E58A           84          mov A, TL0              ; учесть время между переполнением и входом в обработчик
0094 241F           85          add A, #(TICK_L+7)      ; компенсировать семь циклов остановленного таймера
0096 F58A           86          mov TL0, A
0098 E58C           87          mov A, TH0
009A 34FC           88          addc A, #TICK_H
009C F58C           89          mov TH0, A
009E D28C           90          setb TR0                ; задержка обслуживания не накапливается в каждом тике
00A0 E530           91          mov A, TicksLo
00A2 7002           92          jnz TickDec
00A4 1531           93          dec TicksHi             ; заём при уменьшении 16-разрядного счётчика
00A6                94  TickDec:
00A6 1530           95          dec TicksLo
00A8 E530           96          mov A, TicksLo
00AA 4531           97          orl A, TicksHi
00AC 7008           98          jnz TickDone            ; ненулевой остаток сохраняет текущую индикацию
00AE C28C           99          clr TR0
00B0 90E000        100          mov DPTR, #ADR_IND
00B3 74FF          101          mov A, #IND_OFF
00B5 F0            102          movx @DPTR, A           ; срок T3 истёк
00B6               103  TickDone:
00B6 D083          104          pop DPH
00B8 D082          105          pop DPL
00BA D0D0          106          pop PSW
00BC D0E0          107          pop ACC
00BE 32            108          reti
00BF               109  Segments:
00BF 3F065B4F666D7D077F6F79      110          db 03Fh,006h,05Bh,04Fh,066h,06Dh,07Dh,007h,07Fh,06Fh,079h
                   111  END
                   112  
