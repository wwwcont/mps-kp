                     1  ; Сапелин А.С., А-12-23, 18, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=18 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 18            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 30            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6F8h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1784
              =1    14  
              =1    15  ; --- клавиатура 4x3 и индикатор ---
              =1    16  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 12h          ; флаг пустоты буфера (22h.2)
              =1    26  F_OVF        BIT 1Eh          ; флаг переполнения буфера (23h.6)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.4         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.5         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2452 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 6Ch
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 371           ; T1 = 371 мс
              =1    39  T3_TICKS     EQU 3240          ; T3 = 3240 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; здесь объявление переменных (если нужны)
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
                    26          ; TODO: CS_EN = 1; буфер пуст: HEAD = TAIL = BUF_START, F_EMPTY = 1, F_OVF = 0
002E 120033         27          call BufRead ; %proc%
0031 80FE           28          jmp $ ; %stop%
                    29  
                    30  ; BufRead — чтение самого старого отсчёта из кольцевого буфера.
                    31  ; Вход: нет. Выход: A — отсчёт; F_EMPTY — буфер опустел; F_OVF сброшен (буфер больше не полон).
                    32  ; TODO: что делать при пустом буфере; что портит
0033                33  BufRead:
                    34          ; TODO: movx по адресу TAIL, TAIL на следующую ячейку (BUF_END → BUF_START), флаги
0033 22             35          ret
                    36  END
                    37  
