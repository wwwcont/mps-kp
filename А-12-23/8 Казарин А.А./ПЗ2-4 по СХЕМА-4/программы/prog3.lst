                     1  ; Казарин А.А., А-12-23, 8, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=8 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 8            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A694h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1684
              =1    14  BUF_X2IN     EQU 0BFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 8h          ; флаг пустоты буфера (21h.0)
              =1    27  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2152 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 98h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 271           ; T1 = 271 мс
              =1    40  T3_TICKS     EQU 2740          ; T3 = 2740 мс
              =1    41  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 — конец строба Y2
001B C28E           18          clr TR1                    ; остановить отсчёт длительности
001D D292           19          setb PIN_Y2                ; вернуть строб в пассивное состояние
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h
002E D2B4           28          setb PIN_CSEN              ; включить дешифратор адреса
0030 D292           29          setb PIN_Y2                ; строб неактивен до первого вызова
0032 758911         30          mov TMOD, #11h             ; таймеры в режиме 1
0035 C28E           31          clr TR1                    ; Timer1 остановлен
0037 D2AB           32          setb ET1                   ; разрешить прерывание Timer1
0039 D2AF           33          setb EA                    ; разрешить прерывания глобально
003B 753000         34          mov X1, #0                 ; пример: нулевой ввод держит Y2 пассивным
003E 753100         35          mov X2, #0
0041 120046         36          call Y2Out ; %proc%
0044 80FE           37          jmp $ ; %stop%
                    38  
                    39  ; Y2Out — расчёт Y2 = (G+M+X1+X2) mod 256 (X1 = 0 → Y2 = 0), запись в регистр Y2 и строб T2.
                    40  ; Вход: X1, X2. Выход: регистр Y2; PIN_Y2 = 0 на T2 мкс (конец — в прерывании Timer1).
                    41  ; Портит: A, DPTR, флаги PSW, Timer1.
0046                42  Y2Out:
0046 E530           43          mov A, X1                  ; нулевой X1 требует нулевого выхода
0048 6006           44          jz Y2Zero
004A 2531           45          add A, X2                  ; сложение выполняется по модулю 256
004C 2414           46          add A, #Y2_CONST           ; прибавить G + M из vars.inc
004E 8001           47          sjmp Y2Write
0050                48  Y2Zero:
0050 E4             49          clr A                      ; пассивное значение при X1 = 0
0051                50  Y2Write:
0051 90C000         51          mov DPTR, #ADR_Y2          ; выбрать внешний регистр Y2
0054 F0             52          movx @DPTR, A              ; записать значение до начала стробы
0055 758DF7         53          mov TH1, #T2_RELOAD_H      ; загрузить длительность T2
0058 758B98         54          mov TL1, #T2_RELOAD_L
005B C28F           55          clr TF1                    ; сбросить старое переполнение
005D C292           56          clr PIN_Y2                 ; активная часть стробы начинается
005F D28E           57          setb TR1                   ; Timer1 завершит строб по прерыванию
0061 22             58          ret
                    59  END
                    60  
