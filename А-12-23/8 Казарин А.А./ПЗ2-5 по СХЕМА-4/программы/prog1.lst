                     1  ; Казарин А.А., А-12-23, 8, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=8 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 8            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A694h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1684
              =1    14  BUF_X2IN     EQU 0BFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 8h          ; флаг пустоты буфера (21h.0)
              =1    27  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2152 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 98h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 271           ; T1 = 271 мс
              =1    40  T3_TICKS     EQU 2740          ; T3 = 2740 мс
              =1    41  
                     3  DSEG AT 30h
                     4  KCOL:   DS 1                    ; текущий столбец 0…3
                     5  KROWS:  DS 1                    ; маска нажатых строк
                     6  KROWNO: DS 1                    ; номер строки для таблицы кодов
                     7  KCOUNT: DS 1                    ; число найденных клавиш
                     8  KCODE:  DS 1                    ; код единственной клавиши
                     9  CSEG AT 0h
0000 8029           10          sjmp START
0003                11  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003D         12          call KbScan ; %proc%
0006 32             13          reti
000B                14  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             15          nop
000C 32             16          reti
0013                17  org 13h ; "заглушка" для INT1
0013 00             18          nop
0014 32             19          reti
001B                20  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             21          nop
001C 32             22          reti
0023                23  org 23h ; "заглушка" для UART
0023 00             24          nop
0024 32             25          reti
002B                26  org 2bh
002B                27  START:
                    28  ; Инициализация МК **********************************************
002B 758107         29          mov SP, #07h
002E D2B4           30          setb PIN_CSEN              ; включить дешифратор адресов
0030 902000         31          mov DPTR, #ADR_KB          ; подготовить регистр столбцов
0033 E4             32          clr A
0034 F0             33          movx @DPTR, A              ; все столбцы активны для INT0
0035 D288           34          setb IT0                   ; прерывание INT0 по спаду
0037 D2A8           35          setb EX0                   ; разрешить клавиатурное прерывание
0039 D2AF           36          setb EA                    ; разрешить глобальные прерывания
003B 80FE           37          jmp $ ; %stop%
                    38  
                    39  ; KbScan — сканирование матрицы клавиатуры по столбцам (обработчик INT0).
                    40  ; Вход: нет. Выход: A — код единственной нажатой клавиши по табл. 3 ТЗ или 0FFh.
                    41  ; Портит: A, DPTR, флаги PSW и временные переменные в DSEG.
003D                42  KbScan:
003D C0D0           43          push PSW                  ; сохранить рабочие флаги и адрес данных
003F C082           44          push DPL
0041 C083           45          push DPH
0043 753300         46          mov KCOUNT, #0             ; начать подсчёт нажатий
0046 7534FF         47          mov KCODE, #0FFh           ; значение на случай неоднозначного ввода
0049 753000         48          mov KCOL, #0               ; начать с первого столбца
004C                49  KbColumn:
004C E530           50          mov A, KCOL
004E 9000B9         51          mov DPTR, #ColMask         ; выбрать маску столбца
0051 93             52          movc A, @A+DPTR
0052 902000         53          mov DPTR, #ADR_KB
0055 F0             54          movx @DPTR, A              ; опустить только выбранный столбец
0056 E0             55          movx A, @DPTR              ; прочитать строки матрицы
0057 5407           56          anl A, #((1 SHL KB_ROWS) - 1)
0059 F4             57          cpl A
005A 5407           58          anl A, #((1 SHL KB_ROWS) - 1)
005C F531           59          mov KROWS, A
                    60  
005E E531           61          mov A, KROWS
0060 30E006         62          jnb ACC.0, KRow2           ; строка 1 замкнулась на столбец?
0063 753200         63          mov KROWNO, #0
0066 1200A4         64          call RecordKey
0069                65  KRow2:
0069 E531           66          mov A, KROWS
006B 30E106         67          jnb ACC.1, KRow3           ; строка 2 замкнулась на столбец?
006E 753201         68          mov KROWNO, #1
0071 1200A4         69          call RecordKey
0074                70  KRow3:
0074 E531           71          mov A, KROWS
0076 30E206         72          jnb ACC.2, KNextColumn     ; строка 3 замкнулась на столбец?
0079 753202         73          mov KROWNO, #2
007C 1200A4         74          call RecordKey
007F                75  KNextColumn:
007F 0530           76          inc KCOL                   ; перейти к следующему столбцу
0081 E530           77          mov A, KCOL
0083 B404C6         78          cjne A, #KB_COLS, KbColumn
                    79  
0086 902000         80          mov DPTR, #ADR_KB
0089 E4             81          clr A
008A F0             82          movx @DPTR, A              ; вернуть матрицу в режим ожидания
008B C289           83          clr IE0                    ; убрать спады INT0 во время сканирования
008D E533           84          mov A, KCOUNT
008F B40109         85          cjne A, #1, KbInvalid      ; принимать только одно нажатие
0092 E534           86          mov A, KCODE
0094 D083           87          pop DPH                    ; восстановить регистры, не меняя код в A
0096 D082           88          pop DPL
0098 D0D0           89          pop PSW
009A 22             90          ret
009B                91  KbInvalid:
009B 74FF           92          mov A, #0FFh
009D D083           93          pop DPH                    ; восстановить регистры, не меняя код в A
009F D082           94          pop DPL
00A1 D0D0           95          pop PSW
00A3 22             96          ret
                    97  
                    98  ; RecordKey — учесть одну найденную замкнутую точку матрицы.
                    99  ; Вход: KCOL и KROWNO. Выход: KCOUNT увеличен; KCODE задан для первой клавиши.
                   100  ; Портит: A, DPTR, флаги PSW.
00A4               101  RecordKey:
00A4 0533          102          inc KCOUNT                 ; каждое замыкание — отдельное нажатие
00A6 E533          103          mov A, KCOUNT
00A8 B4010D        104          cjne A, #1, RecordDone     ; код сохраняется только для первой клавиши
00AB E530          105          mov A, KCOL
00AD 23            106          rl A
00AE 2530          107          add A, KCOL                ; индекс столбца умножен на число строк
00B0 2532          108          add A, KROWNO
00B2 9000BD        109          mov DPTR, #KeyMap
00B5 93            110          movc A, @A+DPTR            ; получить код клавиши по таблице раскладки
00B6 F534          111          mov KCODE, A
00B8               112  RecordDone:
00B8 22            113          ret
                   114  
                   115  ; ColMask: при опросе один столбец имеет ноль, остальные — единицы.
00B9               116  ColMask:
00B9 FEFDFBF7      117          db 0FEh, 0FDh, 0FBh, 0F7h
                   118  ; KeyMap расположена столбцами: 1/4/7, 2/5/8, 3/6/9, Т/С/0.
00BD               119  KeyMap:
00BD 0104070205080306090A0B00      120          db 1, 4, 7, 2, 5, 8, 3, 6, 9, 10, 11, 0
                   121  END
                   122  
