                     1  ; Казарин А.А., А-12-23, 8, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=8 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 8            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 20            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0E000h        ; индикатор, CS Y7
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0C000h        ; регистр Y2, CS Y6
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A694h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1684
              =1    14  BUF_MBOX     EQU 0BFFFh        ; «почтовый ящик»: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание)
              =1    15  
              =1    16  ; --- клавиатура 4x3 и индикатор ---
              =1    17  KB_COLS      EQU 4             ; столбцы Col1…Col4 — биты D0…D3 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 3             ; строки Row1…Row3 — биты D0…D2 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 8h          ; флаг пустоты буфера (21h.0)
              =1    27  F_OVF        BIT 14h          ; флаг переполнения буфера (22h.4)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.1         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.2         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2152 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 98h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 271           ; T1 = 271 мс
              =1    40  T3_TICKS     EQU 2740          ; T3 = 2740 мс
              =1    41  
                     3  DSEG AT 30h
                     4  TEMP:   DS 1
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN              ; разрешить выбор внешней памяти
0030 754700         27          mov HEAD_L, #LOW BUF_START ; начать запись с первой ячейки
0033 7548A0         28          mov HEAD_H, #HIGH BUF_START
0036 754900         29          mov TAIL_L, #LOW BUF_START ; начать чтение с той же ячейки
0039 754AA0         30          mov TAIL_H, #HIGH BUF_START
003C D208           31          setb F_EMPTY               ; исходный буфер пуст
003E C214           32          clr F_OVF                  ; переполнения ещё не было
0040 D2AA           33          setb EX1                   ; разрешить внешний запрос X2
0042 D2AF           34          setb EA                    ; разрешить прерывания глобально
0044 120049         35          call BufRead ; %proc%
0047 80FE           36          jmp $ ; %stop%
                    37  
                    38  ; BufRead — чтение самого старого отсчёта из кольцевого буфера.
                    39  ; Вход: нет. Выход: A — отсчёт; F_EMPTY — буфер опустел; F_OVF сброшен (буфер больше не полон).
                    40  ; Портит: DPTR, флаги PSW; при пустом буфере возвращает A = 0.
0049                41  BufRead:
0049 C2AA           42          clr EX1                    ; не менять указатели во время чтения
004B 200836         43          jb F_EMPTY, BufEmpty
004E 854982         44          mov DPL, TAIL_L            ; указать на старейший отсчёт
0051 854A83         45          mov DPH, TAIL_H
0054 E0             46          movx A, @DPTR              ; получить значение из XRAM
0055 F530           47          mov TEMP, A                ; сохранить результат при обновлении указателя
0057 E549           48          mov A, TAIL_L              ; увеличить младшую часть адреса
0059 2401           49          add A, #1
005B F549           50          mov TAIL_L, A
005D E54A           51          mov A, TAIL_H              ; перенести переполнение в старшую часть
005F 3400           52          addc A, #0
0061 F54A           53          mov TAIL_H, A
0063 B4A60B         54          cjne A, #HIGH BUF_END, BufCompareHead
0066 E549           55          mov A, TAIL_L
0068 B49406         56          cjne A, #LOW BUF_END, BufCompareHead
006B 754900         57          mov TAIL_L, #LOW BUF_START ; вернуться к началу кольца
006E 754AA0         58          mov TAIL_H, #HIGH BUF_START
0071                59  BufCompareHead:
0071 E549           60          mov A, TAIL_L              ; последний элемент прочитан?
0073 B54707         61          cjne A, HEAD_L, BufStillHasData
0076 E54A           62          mov A, TAIL_H
0078 B54802         63          cjne A, HEAD_H, BufStillHasData
007B D208           64          setb F_EMPTY               ; голова догнана хвостом: данных нет
007D                65  BufStillHasData:
007D C214           66          clr F_OVF                  ; после чтения место снова свободно
007F E530           67          mov A, TEMP                ; вернуть отсчёт вызывающей программе
0081 D2AA           68          setb EX1                   ; разрешить новые X2
0083 22             69          ret
0084                70  BufEmpty:
0084 7400           71          mov A, #0                  ; пустой буфер возвращает ноль
0086 D2AA           72          setb EX1                   ; восстановить разрешение INT1
0088 22             73          ret
                    74  END
                    75  
