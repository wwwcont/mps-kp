                     1  ; Рязанцев И.В., А-12-23, 17, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=17 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 17            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 29            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6EEh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1774
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 11h          ; флаг пустоты буфера (22h.1)
              =1    26  F_OVF        BIT 1Dh          ; флаг переполнения буфера (23h.5)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2422 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 8Ah
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 361           ; T1 = 361 мс
              =1    39  T3_TICKS     EQU 3190          ; T3 = 3190 мс
              =1    40  
                     3  DSEG AT 30h
                     4  ; переменные не нужны: указатели и флаги заданы в vars.inc
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h ; "заглушка" для INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; дешифратор включён — буфер доступен по movx
0030 754700         27          mov HEAD_L, #LOW(BUF_START)     ; голова — в начало буфера
0033 7548A0         28          mov HEAD_H, #HIGH(BUF_START)
0036 754900         29          mov TAIL_L, #LOW(BUF_START)     ; хвост — туда же: буфер пуст
0039 754AA0         30          mov TAIL_H, #HIGH(BUF_START)
003C D211           31          setb F_EMPTY            ; данных нет
003E C21D           32          clr F_OVF               ; ничего не терялось
0040 7455           33          mov A, #55h             ; пример отсчёта
0042 120047         34          call BufWrite ; %proc%
0045 80FE           35          jmp $ ; %stop%
                    36  
                    37  ; BufWrite — запись отсчёта в кольцевой буфер в ячейку «головы».
                    38  ; Если буфер заполнен целиком (голова = хвост и буфер не пуст), самый старый отсчёт выбрасывается:
                    39  ; хвост сдвигается на следующую ячейку и ставится флаг переполнения.
                    40  ; Вход: A — отсчёт. Выход: отсчёт в буфере, голова сдвинута, F_EMPTY = 0; F_OVF = 1, если отсчёт затёр самый старый.
                    41  ; Портит: ничего (A, B, DPTR, PSW сохраняются).
0047                42  BufWrite:
0047 C0D0           43          push PSW                ; флаги вызывающей программы не трогаем
0049 C082           44          push DPL                ; DPTR тоже сохраняем — он нужен для movx
004B C083           45          push DPH
004D C0F0           46          push B                  ; B будет временным местом для отсчёта
004F F5F0           47          mov B, A                ; отсчёт пока отложим в B
0051 20111B         48          jb F_EMPTY, BwStore     ; пустой буфер не может быть полным
0054 E547           49          mov A, HEAD_L           ; полон ли: голова догнала хвост?
0056 B54916         50          cjne A, TAIL_L, BwStore
0059 E548           51          mov A, HEAD_H
005B B54A11         52          cjne A, TAIL_H, BwStore
005E 854982         53          mov DPL, TAIL_L         ; полон — выбрасываем самый старый отсчёт
0061 854A83         54          mov DPH, TAIL_H
0064 12008E         55          call BufNext
0067 858249         56          mov TAIL_L, DPL
006A 85834A         57          mov TAIL_H, DPH
006D D21D           58          setb F_OVF              ; отметили потерю данных
006F                59  BwStore:
006F 854782         60          mov DPL, HEAD_L
0072 854883         61          mov DPH, HEAD_H
0075 E5F0           62          mov A, B
0077 F0             63          movx @DPTR, A           ; кладём отсчёт в ячейку головы
0078 12008E         64          call BufNext
007B 858247         65          mov HEAD_L, DPL         ; голова смотрит на следующую свободную ячейку
007E 858348         66          mov HEAD_H, DPH
0081 C211           67          clr F_EMPTY             ; теперь в буфере точно что-то есть
0083 E5F0           68          mov A, B                ; вернули отсчёт в A
0085 D0F0           69          pop B                   ; восстанавливаем всё, что сохранили, в обратном порядке
0087 D083           70          pop DPH
0089 D082           71          pop DPL
008B D0D0           72          pop PSW
008D 22             73          ret                     ; запись закончена
                    74  
                    75  ; BufNext — следующая ячейка кольцевого буфера: после последней (BUF_END - 1) идёт первая (BUF_START).
                    76  ; Вход: DPTR — адрес ячейки буфера. Выход: DPTR — адрес следующей ячейки. Портит: A, флаг C.
008E                77  BufNext:
008E A3             78          inc DPTR
008F E582           79          mov A, DPL
0091 B4EE08         80          cjne A, #LOW(BUF_END), BnDone   ; ещё не вышли за конец — готово
0094 E583           81          mov A, DPH
0096 B4A603         82          cjne A, #HIGH(BUF_END), BnDone
0099 90A000         83          mov DPTR, #BUF_START    ; вышли за конец — заворачиваем на начало
009C                84  BnDone:
009C 22             85          ret                     ; DPTR — следующая ячейка
                    86  END
                    87  
