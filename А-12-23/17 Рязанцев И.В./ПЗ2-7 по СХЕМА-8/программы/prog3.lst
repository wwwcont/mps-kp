                     1  ; Рязанцев И.В., А-12-23, 17, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=17 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 17            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 29            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6EEh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1774
              =1    14  
              =1    15  ; --- клавиатура 3x4 и индикатор ---
              =1    16  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    17  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    18  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    19  
              =1    20  ; --- внутреннее ОЗУ ---
              =1    21  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    22  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    23  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    24  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    25  F_EMPTY      BIT 11h          ; флаг пустоты буфера (22h.1)
              =1    26  F_OVF        BIT 1Dh          ; флаг переполнения буфера (23h.5)
              =1    27  
              =1    28  ; --- выводы ---
              =1    29  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    30  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    31  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    32  
              =1    33  ; --- таймеры (кварц 12 МГц) ---
              =1    34  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2422 мкс, Timer1
              =1    35  T2_RELOAD_L  EQU 8Ah
              =1    36  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    37  TICK_L       EQU 18h
              =1    38  Y1_TICKS     EQU 361           ; T1 = 361 мс
              =1    39  T3_TICKS     EQU 3190          ; T3 = 3190 мс
              =1    40  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
                     5  X2:     DS 1                    ; отсчёт из буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h ; "заглушка" для INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h ; "заглушка" для INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 — отсчитали T2, строб Y2 заканчивается
001B C28E           18          clr TR1                 ; таймер больше не нужен
001D D294           19          setb PIN_Y2             ; строб в пассивную единицу
001F 32             20          reti
0023                21  org 23h ; "заглушка" для UART
0023 00             22          nop
0024 32             23          reti
002B                24  org 2bh
002B                25  START:
                    26  ; Инициализация МК **********************************************
002B 758107         27          mov SP, #07h
002E D2B4           28          setb PIN_CSEN           ; дешифратор включён — регистр Y2 доступен по movx
0030 D294           29          setb PIN_Y2             ; строб Y2 пока не активен
0032 53890F         30          anl TMOD, #0Fh          ; Timer1: режим 1 (16 бит), Timer0 не трогаем
0035 438910         31          orl TMOD, #10h
0038 D2BB           32          setb PT1                ; конец строба важнее остального — высокий приоритет
003A D2AB           33          setb ET1                ; прерывание от Timer1
003C D2AF           34          setb EA
003E 753003         35          mov X1, #3              ; пример входных данных
0041 7531C8         36          mov X2, #200
0044 120049         37          call Y2Out ; %proc%
0047 80FE           38          jmp $ ; %stop%
                    39  
                    40  ; Y2Out — вычисление выхода Y2 и его выдача внешнему устройству.
                    41  ; Y2 = (G + M + X1 + X2) mod 256, а при X1 = 0 — просто 0. Значение пишется в регистр Y2,
                    42  ; после этого на P1.4 выдаётся строб 0 длиной T2; конец строба делает обработчик Timer1.
                    43  ; Вход: X1, X2. Выход: регистр Y2, строб на PIN_Y2 запущен. Портит: ничего (A, DPTR, PSW сохраняются).
0049                44  Y2Out:
0049 C0D0           45          push PSW
004B C0E0           46          push ACC
004D C082           47          push DPL
004F C083           48          push DPH
0051 E530           49          mov A, X1
0053 6004           50          jz YoWrite              ; X1 = 0 — выдаём ноль
0055 241D           51          add A, #Y2_CONST        ; G + M + X1; перенос отбрасывается — это и есть mod 256
0057 2531           52          add A, X2
0059                53  YoWrite:
0059 90E000         54          mov DPTR, #ADR_Y2
005C F0             55          movx @DPTR, A           ; сначала данные в регистр
005D C28E           56          clr TR1                 ; на случай, если прошлый строб ещё идёт — перезапускаем отсчёт
005F 758DF6         57          mov TH1, #T2_RELOAD_H   ; Timer1 отсчитает T2
0062 758B8A         58          mov TL1, #T2_RELOAD_L
0065 C28F           59          clr TF1                 ; старый запрос не нужен
0067 C294           60          clr PIN_Y2              ; строб пошёл
0069 D28E           61          setb TR1
006B D083           62          pop DPH
006D D082           63          pop DPL
006F D0E0           64          pop ACC
0071 D0D0           65          pop PSW
0073 22             66          ret
                    67  END
                    68  
