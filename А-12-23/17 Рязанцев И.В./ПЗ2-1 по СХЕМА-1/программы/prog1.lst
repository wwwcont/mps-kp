                     1  ; Рязанцев И.В., А-12-23, 17, v1
                     2  $INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
              =1     1  ; Параметры варианта А-12, M=17 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 17            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 29            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A6EEh        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1774
              =1    14  BUF_MBOX     EQU 0BFFFh        ; «почтовый ящик»: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 11h          ; флаг пустоты буфера (22h.1)
              =1    27  F_OVF        BIT 1Dh          ; флаг переполнения буфера (23h.5)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.3         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.4         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F6h          ; строб Y2 2422 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 8Ah
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 361           ; T1 = 361 мс
              =1    40  T3_TICKS     EQU 3190          ; T3 = 3190 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; переменные не нужны: всё держим в регистрах банка 0
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh ; "заглушка" для Tmr0_ovf
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h ; "заглушка" для INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh ; "заглушка" для Tmr1_ovf
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h ; "заглушка" для UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h
002E D2B4           26          setb PIN_CSEN           ; разрешаем дешифратор, иначе клавиатура не выбирается
0030 902000         27          mov DPTR, #ADR_KB
0033 E4             28          clr A
0034 F0             29          movx @DPTR, A           ; опускаем все столбцы: любое нажатие сразу опустит INT0
0035 D288           30          setb IT0                ; INT0 срабатывает по спаду
0037 C289           31          clr IE0                 ; забываем возможный ложный запрос до инициализации
0039 D2A8           32          setb EX0                ; разрешаем прерывание от клавиатуры
003B D2AF           33          setb EA                 ; и прерывания вообще
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос матрицы клавиатуры 3x4 по столбцам (вызывается из обработчика INT0).
                    37  ; Столбцы опускаются по одному, в каждом считаются замкнутые строки; код берётся из таблицы KeyMap.
                    38  ; Вход: нет. Выход: A — код единственной нажатой клавиши (0…9, Т = 10, С = 11) или 0FFh,
                    39  ; если не нажато ничего или нажато больше одной клавиши. Портит: только A (остальное сохраняется в стеке).
003F                40  KbScan:
003F C0D0           41          push PSW
0041 C0F0           42          push B
0043 C082           43          push DPL
0045 C083           44          push DPH
0047 C002           45          push AR2
0049 C003           46          push AR3
004B C004           47          push AR4
004D C005           48          push AR5
004F C006           49          push AR6
0051 C007           50          push AR7
0053 902000         51          mov DPTR, #ADR_KB
0056 7A00           52          mov R2, #0              ; сколько замкнутых контактов нашли
0058 7BFF           53          mov R3, #0FFh           ; код последней найденной клавиши
005A 7C00           54          mov R4, #0              ; номер текущего столбца (0…KB_COLS-1)
005C 7DFE           55          mov R5, #0FEh           ; маска: опущен только первый столбец
005E                56  KsCol:
005E ED             57          mov A, R5
005F F0             58          movx @DPTR, A           ; опускаем текущий столбец, остальные подняты
0060 E0             59          movx A, @DPTR           ; читаем строки
0061 540F           60          anl A, #(1 SHL KB_ROWS) - 1     ; старшие биты шины не подключены
0063 640F           61          xrl A, #(1 SHL KB_ROWS) - 1     ; теперь 1 — строка замкнута на этот столбец
0065 FF             62          mov R7, A               ; замкнутые строки этого столбца
0066 7E00           63          mov R6, #0              ; номер строки
0068                64  KsRow:
0068 EF             65          mov A, R7
0069 601C           66          jz KsNextCol            ; в этом столбце замкнутых строк больше нет
006B C3             67          clr C
006C 13             68          rrc A                   ; младшая строка уходит в перенос
006D FF             69          mov R7, A
006E 5014           70          jnc KsRowSkip
0070 0A             71          inc R2                  ; нашли ещё одну нажатую клавишу
0071 EE             72          mov A, R6               ; индекс в таблице = строка * KB_COLS + столбец
0072 75F003         73          mov B, #KB_COLS
0075 A4             74          mul AB
0076 2C             75          add A, R4
0077 C082           76          push DPL                ; адрес клавиатуры ещё понадобится
0079 C083           77          push DPH
007B 9000AF         78          mov DPTR, #KeyMap
007E 93             79          movc A, @A+DPTR         ; код клавиши по рис. 4 и табл. 3 ТЗ
007F FB             80          mov R3, A
0080 D083           81          pop DPH
0082 D082           82          pop DPL
0084                83  KsRowSkip:
0084 0E             84          inc R6
0085 80E1           85          sjmp KsRow
0087                86  KsNextCol:
0087 ED             87          mov A, R5
0088 23             88          rl A                    ; опускать будем следующий столбец
0089 FD             89          mov R5, A
008A 0C             90          inc R4
008B BC03D0         91          cjne R4, #KB_COLS, KsCol
008E E4             92          clr A
008F F0             93          movx @DPTR, A           ; опрос закончен: все столбцы снова вниз, чтобы ловить следующее нажатие
0090 EB             94          mov A, R3
0091 BA0102         95          cjne R2, #1, KsBad      ; ровно одна клавиша — отдаём её код
0094 8002           96          sjmp KsDone
0096                97  KsBad:
0096 74FF           98          mov A, #0FFh            ; ничего или несколько клавиш сразу — ошибка
0098                99  KsDone:
0098 C289          100          clr IE0                 ; пока перебирали столбцы, INT0 дёргался — этот запрос лишний
009A D007          101          pop AR7
009C D006          102          pop AR6
009E D005          103          pop AR5
00A0 D004          104          pop AR4
00A2 D003          105          pop AR3
00A4 D002          106          pop AR2
00A6 D083          107          pop DPH
00A8 D082          108          pop DPL
00AA D0F0          109          pop B
00AC D0D0          110          pop PSW
00AE 22            111          ret
                   112  
                   113  ; KeyMap — коды клавиш по строкам сверху вниз, в строке — по столбцам слева направо (рис. 4 ТЗ, 3x4).
00AF 010203        114  KeyMap: DB 1, 2, 3
00B2 040506        115          DB 4, 5, 6
00B5 070809        116          DB 7, 8, 9
00B8 000A0B        117          DB 0, 10, 11
                   118  END
                   119  
