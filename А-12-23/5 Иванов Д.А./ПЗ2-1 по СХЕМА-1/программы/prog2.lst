                     1  ; Иванов Д.А., А-12-23, 5, v1
                     2  $INCLUDE (vars.inc)             ; параметры варианта формирует генератор
              =1     1  ; Параметры варианта А-12, M=5 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 5            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 17            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A676h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1654
              =1    14  BUF_X2IN     EQU 0BFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 5h          ; флаг пустоты буфера (20h.5)
              =1    27  F_OVF        BIT 11h          ; флаг переполнения буфера (22h.1)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2062 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0F2h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 241           ; T1 = 241 мс
              =1    40  T3_TICKS     EQU 2590          ; T3 = 2590 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; дополнительные ячейки ОЗУ не нужны
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; заглушка INT0
0003 00              8          nop
0004 32              9          reti
000B                10  org 0bh                         ; заглушка Timer0
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h                         ; заглушка INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh                         ; заглушка Timer1
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h                         ; заглушка UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек не пересекается с указателями буфера
002E D2B4           26          setb PIN_CSEN           ; разрешить дешифратор внешней памяти
0030 90A000         27          mov DPTR, #BUF_START    ; пустой буфер начинается с первой ячейки кольца
0033 858247         28          mov HEAD_L, DPL
0036 858348         29          mov HEAD_H, DPH
0039 858249         30          mov TAIL_L, DPL
003C 85834A         31          mov TAIL_H, DPH
003F D205           32          setb F_EMPTY            ; после сброса данных нет
0041 C211           33          clr F_OVF
0043 7455           34          mov A, #55h             ; тестовый отсчёт для вызова процедуры
0045 12004A         35          call BufWrite ; %proc%
0048 80FE           36          jmp $ ; %stop%
                    37  
                    38  ; BufWrite — запись байта в кольцевой буфер с политикой полной ёмкости V.
                    39  ; Вход: A — новый отсчёт. Выход: F_EMPTY = 0; F_OVF = 1 только при вытеснении старого байта.
                    40  ; Портит: A, B, DPTR, R6, R7, PSW.
004A                41  BufWrite:
004A F5F0           42          mov B, A                ; сохранить отсчёт на время проверки указателей
004C C211           43          clr F_OVF               ; обычная запись снимает прежний признак переполнения
004E 200531         44          jb F_EMPTY, BW_STORE    ; в пустом кольце совпадение указателей не означает полноту
0051 E547           45          mov A, HEAD_L
0053 B5492C         46          cjne A, TAIL_L, BW_STORE
0056 E548           47          mov A, HEAD_H
0058 B54A27         48          cjne A, TAIL_H, BW_STORE
005B 854982         49          mov DPL, TAIL_L         ; буфер полон: удалить самый старый отсчёт
005E 854A83         50          mov DPH, TAIL_H
0061 A3             51          inc DPTR
0062 AE82           52          mov R6, DPL             ; сохранить полученный адрес для сравнения с концом
0064 AF83           53          mov R7, DPH
0066 90A676         54          mov DPTR, #BUF_END
0069 EE             55          mov A, R6
006A B58209         56          cjne A, DPL, BW_TAIL_KEEP
006D EF             57          mov A, R7
006E B58305         58          cjne A, DPH, BW_TAIL_KEEP
0071 90A000         59          mov DPTR, #BUF_START    ; после BUF_END кольцо продолжается с начала
0074 8004           60          sjmp BW_TAIL_SAVE
0076                61  BW_TAIL_KEEP:
0076 8E82           62          mov DPL, R6
0078 8F83           63          mov DPH, R7
007A                64  BW_TAIL_SAVE:
007A 858249         65          mov TAIL_L, DPL
007D 85834A         66          mov TAIL_H, DPH
0080 D211           67          setb F_OVF              ; новый байт вытеснил самый старый
0082                68  BW_STORE:
0082 854782         69          mov DPL, HEAD_L         ; «голова» указывает на место новой записи
0085 854883         70          mov DPH, HEAD_H
0088 E5F0           71          mov A, B
008A F0             72          movx @DPTR, A           ; записать отсчёт левым портом IDT7005
008B A3             73          inc DPTR
008C AE82           74          mov R6, DPL             ; проверить необходимость заворота головы
008E AF83           75          mov R7, DPH
0090 90A676         76          mov DPTR, #BUF_END
0093 EE             77          mov A, R6
0094 B58209         78          cjne A, DPL, BW_HEAD_KEEP
0097 EF             79          mov A, R7
0098 B58305         80          cjne A, DPH, BW_HEAD_KEEP
009B 90A000         81          mov DPTR, #BUF_START
009E 8004           82          sjmp BW_HEAD_SAVE
00A0                83  BW_HEAD_KEEP:
00A0 8E82           84          mov DPL, R6
00A2 8F83           85          mov DPH, R7
00A4                86  BW_HEAD_SAVE:
00A4 858247         87          mov HEAD_L, DPL         ; сохранить адрес следующей свободной ячейки
00A7 858348         88          mov HEAD_H, DPH
00AA C205           89          clr F_EMPTY             ; после записи буфер заведомо не пуст
00AC 22             90          ret
                    91  END
                    92  
