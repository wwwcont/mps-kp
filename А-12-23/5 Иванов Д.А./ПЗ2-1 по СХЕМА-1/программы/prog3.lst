                     1  ; Иванов Д.А., А-12-23, 5, v1
                     2  $INCLUDE (vars.inc)             ; параметры варианта формирует генератор
              =1     1  ; Параметры варианта А-12, M=5 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 5            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 17            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A676h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1654
              =1    14  BUF_X2IN     EQU 0BFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 5h          ; флаг пустоты буфера (20h.5)
              =1    27  F_OVF        BIT 11h          ; флаг переполнения буфера (22h.1)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2062 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0F2h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 241           ; T1 = 241 мс
              =1    40  T3_TICKS     EQU 2590          ; T3 = 2590 мс
              =1    41  
                     3  DSEG AT 30h
                     4  X1:     DS 1                    ; цифра с клавиатуры, ноль задаёт пассивный Y2
                     5  X2:     DS 1                    ; очередной отсчёт из кольцевого буфера
                     6  CSEG AT 0h
0000 8029            7          sjmp START
0003                 8  org 03h                         ; заглушка INT0
0003 00              9          nop
0004 32             10          reti
000B                11  org 0bh                         ; заглушка Timer0
000B 00             12          nop
000C 32             13          reti
0013                14  org 13h                         ; заглушка INT1
0013 00             15          nop
0014 32             16          reti
001B                17  org 1bh                         ; Timer1 — окончание строба Y2
001B C28E           18          clr TR1                 ; остановить таймер до следующего вызова
001D D296           19          setb PIN_Y2             ; вернуть строб в пассивную единицу
001F C28F           20          clr TF1                 ; снять обработанный запрос переполнения
0021 32             21          reti
0023                22  org 23h                         ; заглушка UART
0023 00             23          nop
0024 32             24          reti
002B                25  org 2bh
002B                26  START:
                    27  ; Инициализация МК **********************************************
002B 758107         28          mov SP, #07h            ; стек расположен ниже переменных X1 и X2
002E D2B4           29          setb PIN_CSEN           ; разрешить дешифратор внешних устройств
0030 D296           30          setb PIN_Y2             ; начальное состояние строба пассивное
0032 758911         31          mov TMOD, #11h          ; оба таймера настроены на 16-разрядный режим 1
0035 C28E           32          clr TR1
0037 C28F           33          clr TF1
0039 D2AB           34          setb ET1               ; разрешить завершение строба от Timer1
003B D2AF           35          setb EA
003D 753003         36          mov X1, #3              ; тестовые входные данные для вызова процедуры
0040 7531C8         37          mov X2, #200
0043 120048         38          call Y2Out ; %proc%
0046 80FE           39          jmp $ ; %stop%
                    40  
                    41  ; Y2Out — вычисление Y2 и запуск сопровождающего строба Timer1.
                    42  ; Вход: X1 и X2 в ОЗУ. Выход: байт записан в ADR_Y2, PIN_Y2 удерживается в нуле T2 мкс.
                    43  ; Портит: A, DPTR, PSW.
0048                44  Y2Out:
0048 D2B4           45          setb PIN_CSEN           ; гарантировать доступ к регистру Y2
004A C28E           46          clr TR1                 ; повторный вызов начинает новый полный интервал
004C D296           47          setb PIN_Y2             ; завершить прежний строб, если он ещё выполнялся
004E C28F           48          clr TF1
0050 E530           49          mov A, X1
0052 6006           50          jz Y2_ZERO              ; при X1 = 0 выход должен быть пассивным
0054 2531           51          add A, X2
0056 2411           52          add A, #Y2_CONST        ; переполнение отбрасывается: результат по mod 256
0058 8001           53          sjmp Y2_WRITE
005A                54  Y2_ZERO:
005A E4             55          clr A
005B                56  Y2_WRITE:
005B 90E000         57          mov DPTR, #ADR_Y2
005E F0             58          movx @DPTR, A           ; сначала обновить данные выходного регистра
005F 758DF7         59          mov TH1, #T2_RELOAD_H   ; затем подготовить длительность строба T2
0062 758BF2         60          mov TL1, #T2_RELOAD_L
0065 D28E           61          setb TR1
0067 C296           62          clr PIN_Y2              ; активный ноль выдаётся только после записи Y2
0069 22             63          ret
                    64  END
                    65  
