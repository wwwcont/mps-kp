                     1  ; Иванов Д.А., А-12-23, 5, v1
                     2  $INCLUDE (vars.inc)             ; параметры варианта формирует генератор
              =1     1  ; Параметры варианта А-12, M=5 (ТЗ 2026). Сгенерировано mpsgen — не править руками.
              =1     2  
              =1     3  VAR_M        EQU 5            ; номер варианта
              =1     4  VAR_G        EQU 12            ; номер группы
              =1     5  Y2_CONST     EQU 17            ; G+M: Y2 = (Y2_CONST + X1 + X2) mod 256
              =1     6  
              =1     7  ; --- адреса внешних устройств (movx) ---
              =1     8  ADR_IND      EQU 0C000h        ; индикатор, CS Y6
              =1     9  ADR_KB       EQU 2000h        ; клавиатура: запись столбцов / чтение строк, CS Y1
              =1    10  ADR_Y2       EQU 0E000h        ; регистр Y2, CS Y7
              =1    11  BUF_START    EQU 0A000h        ; первая ячейка буфера, CS Y5
              =1    12  BUF_END      EQU 0A676h        ; первая ячейка ЗА буфером (точка заворота)
              =1    13  BUF_SIZE     EQU 1654
              =1    14  BUF_X2IN     EQU 0BFFFh        ; ячейка обмена: сюда внешнее устройство пишет X2 правым портом (строб X2 = прерывание INT1)
              =1    15  
              =1    16  ; --- клавиатура 3x4 и индикатор ---
              =1    17  KB_COLS      EQU 3             ; столбцы Col1…Col3 — биты D0…D2 при записи в ADR_KB (0 — столбец опрашивается)
              =1    18  KB_ROWS      EQU 4             ; строки Row1…Row4 — биты D0…D3 при чтении ADR_KB (0 — замкнута); старшие биты не определены — маскировать
              =1    19  IND_OFF      EQU 0FFh           ; индикатор погашен (общий анод: 0 зажигает сегмент; D0…D7 = a…g, dp)
              =1    20  
              =1    21  ; --- внутреннее ОЗУ ---
              =1    22  HEAD_L       EQU 47h          ; «голова», младший байт
              =1    23  HEAD_H       EQU 48h          ; «голова», старший байт
              =1    24  TAIL_L       EQU 49h          ; «хвост», младший байт
              =1    25  TAIL_H       EQU 4Ah          ; «хвост», старший байт
              =1    26  F_EMPTY      BIT 5h          ; флаг пустоты буфера (20h.5)
              =1    27  F_OVF        BIT 11h          ; флаг переполнения буфера (22h.1)
              =1    28  
              =1    29  ; --- выводы ---
              =1    30  PIN_Y1       BIT P1.5         ; строб Y1, активный 0
              =1    31  PIN_Y2       BIT P1.6         ; строб Y2, активный 0
              =1    32  PIN_CSEN     BIT P3.4         ; CS_EN: разрешение дешифратора CS (1 — CS активны)
              =1    33  
              =1    34  ; --- таймеры (кварц 12 МГц) ---
              =1    35  T2_RELOAD_H  EQU 0F7h          ; строб Y2 2062 мкс, Timer1
              =1    36  T2_RELOAD_L  EQU 0F2h
              =1    37  TICK_H       EQU 0FCh          ; тик 1 мс для Y1/T3, Timer0
              =1    38  TICK_L       EQU 18h
              =1    39  Y1_TICKS     EQU 241           ; T1 = 241 мс
              =1    40  T3_TICKS     EQU 2590          ; T3 = 2590 мс
              =1    41  
                     3  DSEG AT 30h
                     4  ; дополнительные ячейки ОЗУ не нужны: временные значения хранятся в регистрах
                     5  CSEG AT 0h
0000 8029            6          sjmp START
0003                 7  org 03h                         ; INT0 — нажатие клавиши
0003 12003F          8          call KbScan ; %proc%
0006 32              9          reti
000B                10  org 0bh                         ; заглушка Timer0
000B 00             11          nop
000C 32             12          reti
0013                13  org 13h                         ; заглушка INT1
0013 00             14          nop
0014 32             15          reti
001B                16  org 1bh                         ; заглушка Timer1
001B 00             17          nop
001C 32             18          reti
0023                19  org 23h                         ; заглушка UART
0023 00             20          nop
0024 32             21          reti
002B                22  org 2bh
002B                23  START:
                    24  ; Инициализация МК **********************************************
002B 758107         25          mov SP, #07h            ; стек начинается после банка регистров 0
002E D2B4           26          setb PIN_CSEN           ; разрешить дешифратор внешних устройств
0030 902000         27          mov DPTR, #ADR_KB       ; адрес регистра столбцов клавиатуры
0033 E4             28          clr A                   ; все столбцы держать в нуле для появления INT0
0034 F0             29          movx @DPTR, A
0035 D288           30          setb IT0                ; INT0 срабатывает по спаду
0037 C289           31          clr IE0                 ; убрать возможный запрос от инициализации
0039 D2A8           32          setb EX0                ; разрешить прерывание клавиатуры
003B D2AF           33          setb EA                 ; общее разрешение прерываний
003D 80FE           34          jmp $ ; %stop%
                    35  
                    36  ; KbScan — опрос всех контактов матрицы 3×4 по столбцам.
                    37  ; Вход: нет. Выход: A — код единственной клавиши по таблице 3 ТЗ, иначе 0FFh.
                    38  ; Портит: B, DPTR, R0–R5, PSW. Перед возвратом снова опускает все столбцы.
003F                39  KbScan:
003F 902000         40          mov DPTR, #ADR_KB       ; одна ячейка служит для записи столбцов и чтения строк
0042 7801           41          mov R0, #1              ; маска выбранного столбца
0044 7900           42          mov R1, #0              ; число найденных замкнутых контактов
0046 7AFF           43          mov R2, #0FFh           ; код первой найденной клавиши
0048 7B00           44          mov R3, #0              ; номер столбца, начиная с нуля
004A                45  KB_COLUMN:
004A E8             46          mov A, R0               ; выбранный столбец должен получить нулевой уровень
004B F4             47          cpl A
004C 5407           48          anl A, #(1 SHL KB_COLS) - 1
004E F0             49          movx @DPTR, A           ; остальные столбцы временно подняты в единицу
004F E0             50          movx A, @DPTR           ; прочитать активные нулём строки
0050 540F           51          anl A, #(1 SHL KB_ROWS) - 1
0052 F4             52          cpl A                   ; после инверсии единица означает нажатую клавишу
0053 540F           53          anl A, #(1 SHL KB_ROWS) - 1
0055 FD             54          mov R5, A               ; сохранить биты строк текущего столбца
0056 7C00           55          mov R4, #0              ; номер проверяемой строки
0058                56  KB_ROW:
0058 ED             57          mov A, R5
0059 5401           58          anl A, #1               ; проверить младший ещё не разобранный бит
005B 6017           59          jz KB_NEXT_ROW
005D 09             60          inc R1                  ; учитывается каждое замыкание во всей матрице
005E E9             61          mov A, R1
005F B40112         62          cjne A, #1, KB_NEXT_ROW ; код нужен только для первого замыкания
0062 EC             63          mov A, R4
0063 B40307         64          cjne A, #3, KB_DIGIT    ; последняя строка содержит 0, «Т» и «С»
0066 EB             65          mov A, R3
0067 600A           66          jz KB_SAVE              ; Row4/Col1 соответствует цифре 0
0069 2409           67          add A, #9               ; Row4/Col2 и Row4/Col3 дают коды 10 и 11
006B 8006           68          sjmp KB_SAVE
006D                69  KB_DIGIT:
006D 75F003         70          mov B, #KB_COLS         ; для первых трёх строк код = row*3+col+1
0070 A4             71          mul AB
0071 2B             72          add A, R3
0072 04             73          inc A
0073                74  KB_SAVE:
0073 FA             75          mov R2, A               ; запомнить код единственного кандидата
0074                76  KB_NEXT_ROW:
0074 ED             77          mov A, R5               ; перейти к следующему биту строки
0075 C3             78          clr C
0076 13             79          rrc A
0077 FD             80          mov R5, A
0078 0C             81          inc R4
0079 BC04DC         82          cjne R4, #KB_ROWS, KB_ROW
007C E8             83          mov A, R0               ; выбрать следующий столбец
007D 23             84          rl A
007E F8             85          mov R0, A
007F 0B             86          inc R3
0080 BB03C7         87          cjne R3, #KB_COLS, KB_COLUMN
0083 E4             88          clr A                   ; вернуть все столбцы в ноль до следующего нажатия
0084 F0             89          movx @DPTR, A
0085 C289           90          clr IE0                 ; сканирование могло создать лишний фронт запроса
0087 E9             91          mov A, R1
0088 B40102         92          cjne A, #1, KB_BAD      ; ноль или несколько клавиш считаются ошибкой
008B EA             93          mov A, R2
008C 22             94          ret
008D                95  KB_BAD:
008D 74FF           96          mov A, #0FFh
008F 22             97          ret
                    98  END
                    99  
