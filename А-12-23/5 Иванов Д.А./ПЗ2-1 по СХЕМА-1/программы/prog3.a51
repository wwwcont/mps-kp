; Иванов Д.А., А-12-23, 5, v1
$INCLUDE (vars.inc)             ; параметры варианта формирует генератор
DSEG AT 30h
X1:     DS 1                    ; цифра с клавиатуры, ноль задаёт пассивный Y2
X2:     DS 1                    ; очередной отсчёт из кольцевого буфера
CSEG AT 0h
        sjmp START
org 03h                         ; заглушка INT0
        nop
        reti
org 0bh                         ; заглушка Timer0
        nop
        reti
org 13h                         ; заглушка INT1
        nop
        reti
org 1bh                         ; Timer1 — окончание строба Y2
        clr TR1                 ; остановить таймер до следующего вызова
        setb PIN_Y2             ; вернуть строб в пассивную единицу
        clr TF1                 ; снять обработанный запрос переполнения
        reti
org 23h                         ; заглушка UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h            ; стек расположен ниже переменных X1 и X2
        setb PIN_CSEN           ; разрешить дешифратор внешних устройств
        setb PIN_Y2             ; начальное состояние строба пассивное
        mov TMOD, #11h          ; оба таймера настроены на 16-разрядный режим 1
        clr TR1
        clr TF1
        setb ET1               ; разрешить завершение строба от Timer1
        setb EA
        mov X1, #3              ; тестовые входные данные для вызова процедуры
        mov X2, #200
        call Y2Out ; %proc%
        jmp $ ; %stop%

; Y2Out — вычисление Y2 и запуск сопровождающего строба Timer1.
; Вход: X1 и X2 в ОЗУ. Выход: байт записан в ADR_Y2, PIN_Y2 удерживается в нуле T2 мкс.
; Портит: A, DPTR, PSW.
Y2Out:
        setb PIN_CSEN           ; гарантировать доступ к регистру Y2
        clr TR1                 ; повторный вызов начинает новый полный интервал
        setb PIN_Y2             ; завершить прежний строб, если он ещё выполнялся
        clr TF1
        mov A, X1
        jz Y2_ZERO              ; при X1 = 0 выход должен быть пассивным
        add A, X2
        add A, #Y2_CONST        ; переполнение отбрасывается: результат по mod 256
        sjmp Y2_WRITE
Y2_ZERO:
        clr A
Y2_WRITE:
        mov DPTR, #ADR_Y2
        movx @DPTR, A           ; сначала обновить данные выходного регистра
        mov TH1, #T2_RELOAD_H   ; затем подготовить длительность строба T2
        mov TL1, #T2_RELOAD_L
        setb TR1
        clr PIN_Y2              ; активный ноль выдаётся только после записи Y2
        ret
END
